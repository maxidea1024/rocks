<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Project that puts the module and target rules of game templates (Templates/**) into the C# format check (Rocks.Format.slnx). These rules do not go into
    the engine rules assembly (Build/Rules/Rocks.Engine.Rules.csproj); the game build compiles them separately against the installed SDK's Rocks.Build
    assembly (Rocks.Game.Rules of InstalledSdk). So they belong to no tool project, and because the format check only looks at project
    Compile items, they are grouped here with the same files (*.Build.cs and *.Target.cs) and the same references as the game build.
    They are not added to the build bootstrap (Programs/Rocks.Tools.csproj); the integration test's game build verifies that the template rules compile.
  -->
  <PropertyGroup><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Programs/Rocks.Build.Abstractions/Rocks.Build.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Templates/**/*.Build.cs;../../Templates/**/*.Target.cs" />
  </ItemGroup>
</Project>
