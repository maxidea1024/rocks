<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Module and target rules assembly (counterpart of UE's UBT rules assembly). Collects and compiles the rules in these locations.
    - Build/Rules/*.cs: rule base classes shared by several modules.
    - Core/Source/**/<Module>.Build.cs, *.Target.cs: foundation library (Core layer) modules.
    - Engine/Source/**, Engine/Plugins/**: game engine layer modules and engine plugins.
    - Programs/**: modules and targets of executable programs (C++). C# tool projects (Programs/Rocks.*) are not rules and are excluded.
  -->
  <ItemGroup>
    <ProjectReference Include="../../Programs/Rocks.Build.Abstractions/Rocks.Build.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Core/Source/**/*.Build.cs;../../Core/Source/**/*.Target.cs" />
    <Compile Include="../../Engine/Source/**/*.Build.cs;../../Engine/Source/**/*.Target.cs" />
    <Compile Include="../../Engine/Plugins/**/*.Build.cs;../../Engine/Plugins/**/*.Target.cs" />
    <Compile Include="../../Programs/**/*.Build.cs;../../Programs/**/*.Target.cs" Exclude="../../Programs/Rocks.*/**" />
  </ItemGroup>
</Project>
