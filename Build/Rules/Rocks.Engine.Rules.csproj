<Project Sdk="Microsoft.NET.Sdk">
  <!--
    모듈·타깃 규칙 어셈블리다(UE의 UBT rules 어셈블리 대응). 다음 위치의 규칙을 모두 모아 컴파일한다.
    - Build/Rules/*.cs: 여러 모듈이 함께 쓰는 규칙 기반 클래스.
    - Core/Source/**/<Module>.Build.cs, *.Target.cs: 기반 라이브러리(Core 계층) 모듈.
    - Engine/Source/**, Engine/Plugins/**: 게임 엔진 계층 모듈과 엔진 플러그인.
    - Programs/**: 실행 프로그램(C++)의 모듈·타깃. C# 도구 프로젝트(Programs/Rocks.*)는 규칙이 아니므로 제외한다.
  -->
  <ItemGroup>
    <ProjectReference Include="../../Programs/Rocks.Build.Abstractions/Rocks.Build.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../Core/Source/**/*.Build.cs;../../Core/Source/**/*.Target.cs" />
    <Compile Include="../../Engine/Source/**/*.Build.cs;../../Engine/Source/**/*.Target.cs" />
    <Compile Include="../../Engine/Plugins/**/*.Build.cs;../../Engine/Plugins/**/*.Target.cs" />
    <Compile Include="../../Programs/**/*.Build.cs;../../Programs/**/*.Target.cs" Exclude="../../Programs/Rocks.*/**" />
  </ItemGroup>
</Project>
