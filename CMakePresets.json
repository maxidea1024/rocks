{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-clang-debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "windows-clang-release",
      "inherits": "windows-clang-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "macos-clang-debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-clang-asan",
      "inherits": "macos-clang-debug",
      "cacheVariables": {
        "ROCKS_ASAN": "ON"
      }
    },
    {
      "name": "windows-clang-core",
      "inherits": "windows-clang-debug",
      "cacheVariables": {
        "ROCKS_BUILD_OBJECT": "OFF"
      }
    },
    {
      "name": "windows-clang-asan",
      "inherits": "windows-clang-debug",
      "cacheVariables": {
        "ROCKS_ASAN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug"
    },
    {
      "name": "windows-clang-release",
      "configurePreset": "windows-clang-release"
    },
    {
      "name": "macos-clang-debug",
      "configurePreset": "macos-clang-debug"
    },
    {
      "name": "macos-clang-asan",
      "configurePreset": "macos-clang-asan"
    },
    {
      "name": "windows-clang-core",
      "configurePreset": "windows-clang-core"
    },
    {
      "name": "windows-clang-asan",
      "configurePreset": "windows-clang-asan"
    }
  ],
  "testPresets": [
    {
      "name": "windows-clang-debug",
      "configurePreset": "windows-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-release",
      "configurePreset": "windows-clang-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-clang-debug",
      "configurePreset": "macos-clang-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "macos-clang-asan",
      "configurePreset": "macos-clang-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-core",
      "configurePreset": "windows-clang-core",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-clang-asan",
      "configurePreset": "windows-clang-asan",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
