<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Rocks.Tooling.Common/Rocks.Tooling.Common.csproj" />
    <!-- The Release exclusion policy (ReleaseExclusion) evaluates module and target rules (RuleLoader). -->
    <ProjectReference Include="../Rocks.Build.Abstractions/Rocks.Build.Abstractions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- C# member blank line check (CSharpMemberSpacing) reads syntax trees only. One exact version (Docs/CodingStyle.md). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="[5.9.0]" />
  </ItemGroup>
</Project>
