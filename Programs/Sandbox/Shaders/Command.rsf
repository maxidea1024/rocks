// 명령 기록 self-test 셰이더다(기본도형 모드·compute 쓰기와 읽기·간접 인자·MRT·그리기별 상수).
#include "/Plugin/Sandbox/Common.rsh"

struct FillConstants {
    // [0].x 깊이, [0].y 모드(0 삼각형, 1 띠, 2 선, 3 점), [4] 색이다.
    float4 constants[5];
};

ROCKS_ROOT_CONSTANTS(FillConstants, Fill);

struct FillOutput {
    float4 position : SV_Position;
#if ROCKS_SPIRV
    // Vulkan·GLES 점 기본도형은 점 크기를 써야 한다(D3D 점은 늘 1 pixel).
    [[vk::builtin("PointSize")]] float pointSize : PSIZE;
#endif
};

FillOutput FillVS(uint id : SV_VertexID) {
    FillOutput output;
    float mode = Fill.constants[0].y;
    float2 p;
    if (mode < 0.5) {
        p = float2((id << 1) & 2, id & 2) * 2.0 - 1.0;
    } else if (mode < 1.5) {
        p = float2((id >> 1) & 1, id & 1) * 2.0 - 1.0;
    } else if (mode < 2.5) {
        p = float2(id == 0 ? -1.0 : 1.0, -0.125);
    } else {
        p = float2(0.125, -0.125);
    }

    output.position = float4(p, Fill.constants[0].x, 1.0);
#if ROCKS_SPIRV
    output.pointSize = 1.0;
#endif
    return output;
}

float4 FillPS(FillOutput input) : SV_Target0 {
    return Fill.constants[4];
}

RWStructuredBuffer<float4> Items;
ROCKS_IMAGE_FORMAT(r32ui) RWBuffer<uint> Codes;

[numthreads(4, 1, 1)]
void WriterCS(uint3 id : SV_DispatchThreadID) {
    Items[id.x] = float4(Fill.constants[4].xy, 0.0, 1.0);
    Codes[id.x] = 0x40u + id.x * 16u;
}

StructuredBuffer<float4> ReadItems;
Buffer<uint> ReadCodes;

struct ReaderOutput {
    float4 position : SV_Position;
    float4 color : TEXCOORD0;
};

ReaderOutput ReaderVS(uint id : SV_VertexID) {
    ReaderOutput output;
    output.position = FullScreenPosition(id);
    output.color = float4(0.0, 0.0, ReadCodes.Load(2) / 255.0, 1.0);
    return output;
}

float4 ReaderPS(ReaderOutput input) : SV_Target0 {
    return float4(ReadItems[1].xy, input.color.z, 1.0);
}

RWByteAddressBuffer Arguments;

[numthreads(1, 1, 1)]
void ArgumentsCS(uint3 id : SV_DispatchThreadID) {
    Arguments.Store4(0, uint4(3, 1, 0, 0));
    Arguments.Store4(16, uint4(3, 1, 0, 0));
    Arguments.Store(32, 0);
    Arguments.Store3(36, uint3(2, 1, 1));
}

RWByteAddressBuffer Marks;

[numthreads(1, 1, 1)]
void MarkerCS(uint3 group : SV_GroupID) {
    Marks.Store(group.x * 4, 0xC0DE0000u + group.x);
}

// 파이프라인 이름 표에 없는 쓰기 자원이다(음성 대조).
RWByteAddressBuffer Outside;

[numthreads(1, 1, 1)]
void OutsideCS(uint3 id : SV_DispatchThreadID) {
    Outside.Store(0, 1);
}

struct MrtOutput {
    float4 c0 : SV_Target0;
    float4 c1 : SV_Target1;
    float4 c2 : SV_Target2;
    float4 c3 : SV_Target3;
    float4 c4 : SV_Target4;
    float4 c5 : SV_Target5;
    uint c6 : SV_Target6;
    float4 c7 : SV_Target7;
};

MrtOutput MrtPS(float4 position : SV_Position) {
    MrtOutput output;
    output.c0 = float4(0.0 / 8.0, 0.5, 0.25, 1.0);
    output.c1 = float4(1.0 / 8.0, 0.5, 0.25, 1.0);
    output.c2 = float4(2.0 / 8.0, 0.5, 0.25, 1.0);
    output.c3 = float4(3.0 / 8.0, 0.5, 0.25, 1.0);
    output.c4 = float4(4.0 / 8.0, 0.5, 0.25, 1.0);
    output.c5 = float4(5.0 / 8.0, 0.5, 0.25, 1.0);
    output.c6 = 1234u;
    output.c7 = float4(7.0 / 8.0, 0.5, 0.25, 1.0);
    return output;
}
