// 앞면 판정 대조다(셰이더가 본 앞면은 초록, 뒤면은 빨강).
struct VSInput {
    float3 position : ATTRIBUTE0;
};

float4 VSMain(VSInput input) : SV_Position {
    return float4(input.position, 1.0);
}

float4 PSMain(float4 position : SV_Position, bool front : SV_IsFrontFace) : SV_Target0 {
    return front ? float4(0.0, 1.0, 0.0, 1.0) : float4(1.0, 0.0, 0.0, 1.0);
}
