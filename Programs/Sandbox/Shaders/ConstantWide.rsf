// 단계마다 상수 버퍼 14개(D3D12 형식 정의 상한)를 읽는 D3D12 self-test 셰이더다(Docs/Design/
// RenderBase 9.11절 5항 — root CBV 예산을 넘겨 CBV table로 내린다). Debug PS는 개발 전용
// 퍼뮤테이션이라 진단 root UAV가 더해진다(ShaderSystem 7.2절 12항).
#include "/Plugin/Sandbox/Common.rsh"

struct VSOutput {
    float4 position : SV_Position;
    float4 color : TEXCOORD0;
};

cbuffer V0 {
    float4 v0;
};

cbuffer V1 {
    float4 v1;
};

cbuffer V2 {
    float4 v2;
};

cbuffer V3 {
    float4 v3;
};

cbuffer V4 {
    float4 v4;
};

cbuffer V5 {
    float4 v5;
};

cbuffer V6 {
    float4 v6;
};

cbuffer V7 {
    float4 v7;
};

cbuffer V8 {
    float4 v8;
};

cbuffer V9 {
    float4 v9;
};

cbuffer V10 {
    float4 v10;
};

cbuffer V11 {
    float4 v11;
};

cbuffer V12 {
    float4 v12;
};

cbuffer V13 {
    float4 v13;
};

VSOutput ConstantWideVS(uint id : SV_VertexID) {
    VSOutput output;
    output.position = FullScreenPosition(id);
    output.color = float4((v0 + v1 + v2 + v3 + v4 + v5 + v6 + v7 + v8 + v9 + v10 + v11 + v12 + v13).xyz, 1.0);
    return output;
}

cbuffer P0 {
    float4 p0;
};

cbuffer P1 {
    float4 p1;
};

cbuffer P2 {
    float4 p2;
};

cbuffer P3 {
    float4 p3;
};

cbuffer P4 {
    float4 p4;
};

cbuffer P5 {
    float4 p5;
};

cbuffer P6 {
    float4 p6;
};

cbuffer P7 {
    float4 p7;
};

cbuffer P8 {
    float4 p8;
};

cbuffer P9 {
    float4 p9;
};

cbuffer P10 {
    float4 p10;
};

cbuffer P11 {
    float4 p11;
};

cbuffer P12 {
    float4 p12;
};

cbuffer P13 {
    float4 p13;
};

float4 ConstantWidePS(VSOutput input) : SV_Target0 {
    const uint index = (uint)input.position.x;
    if (index == 0u) {
        return p0;
    }

    if (index == 1u) {
        return p1;
    }

    if (index == 2u) {
        return p2;
    }

    if (index == 3u) {
        return p3;
    }

    if (index == 4u) {
        return p4;
    }

    if (index == 5u) {
        return p5;
    }

    if (index == 6u) {
        return p6;
    }

    if (index == 7u) {
        return p7;
    }

    if (index == 8u) {
        return p8;
    }

    if (index == 9u) {
        return p9;
    }

    if (index == 10u) {
        return p10;
    }

    if (index == 11u) {
        return p11;
    }

    if (index == 12u) {
        return p12;
    }

    if (index == 13u) {
        return p13;
    }

    return input.color;
}

float4 ConstantWideDebugPS(VSOutput input) : SV_Target0 {
#if defined(ROCKS_DEBUG_BUFFER)
    // 진단 버퍼를 셰이더가 쓰게 둔다(x는 음수가 아니므로 실제로는 쓰지 않는다).
    if (input.position.x < 0.0) {
        RocksDebugBuffer.Store(0, 1u);
    }
#endif

    const uint index = (uint)input.position.x;
    if (index == 0u) {
        return p0;
    }

    if (index == 1u) {
        return p1;
    }

    if (index == 2u) {
        return p2;
    }

    if (index == 3u) {
        return p3;
    }

    if (index == 4u) {
        return p4;
    }

    if (index == 5u) {
        return p5;
    }

    if (index == 6u) {
        return p6;
    }

    if (index == 7u) {
        return p7;
    }

    if (index == 8u) {
        return p8;
    }

    if (index == 9u) {
        return p9;
    }

    if (index == 10u) {
        return p10;
    }

    if (index == 11u) {
        return p11;
    }

    if (index == 12u) {
        return p12;
    }

    if (index == 13u) {
        return p13;
    }

    return input.color;
}
