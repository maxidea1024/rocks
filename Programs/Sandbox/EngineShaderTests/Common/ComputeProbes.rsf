// A01 CS 전용 API probe다(Docs/Design/EngineShaders 14.2·14.6절 2항). 기대값은 Sandbox
// EngineShaderComputeSelfTest.cpp(CPU)다. 입력은 ProbeCommon.rsh 생성기(결정 SLD20)다. 그리기별 상수는
// ProbeConstants(control.x 함수 | 선택자 << 16, control.y 사례·원소 수, control.z byte offset)다.
// - ComputeDispatchProbe: ComputeDispatch.rsh 함수 결과를 사례마다 uint4 기록 하나로.
// - GroupOperationsProbe: WaveOperations.rsh 함수(퍼뮤테이션 PROBE_GROUP_SIZE 0·1·2 = 64·256·100 스레드,
//   PROBE_FORCE_GROUPSHARED)를 스레드마다 uint4 기록 셋으로(정수 넷, float·broadcast 넷, 웨이브 배치).
// - WrappedDispatchProbe: 감싼 1D dispatch의 선형 그룹마다 계수 +1(모든 그룹이 정확히 한 번인지).
// - WriteDispatchArgumentsProbe: DispatchArgumentsForThreads 결과를 간접 인자 버퍼에 쓴다.
#include "/Engine/Private/Common/ShaderPrelude.rsh"
#include "/Engine/Private/Common/ComputeDispatch.rsh"
#include "/Plugin/EngineShaderTests/Common/ProbeCommon.rsh"

RWStructuredBuffer<uint4> ProbeRecords;

#if !defined(PROBE_GROUP_SIZE)

RWStructuredBuffer<uint> GroupCounts;
RWByteAddressBuffer ProbeArguments;

// 간접 인자 경계 사례의 스레드 수다(0, 1, 그룹 하나 안팎, 감싸기 경계, uint32 끝).
static const uint ProbeDispatchSpecialThreads[8] = {0u, 1u, 63u, 64u, 65u, 4194240u, 4194241u, 0xffffffffu};

// 사례 함수는 출구가 하나다(FXC 단일 출구 규칙 — Docs/Design/EngineShaders 7.1절).
uint4 DivideRoundUpCase(uint c) {
    const uint a = c < 4u ? (c < 2u ? 0xffffffffu : 0u) : ProbeBits(c, 0u);
    const uint b = c < 4u ? ((c & 1u) != 0u ? 0xffffffffu : 1u) : (ProbeBits(c, 1u) >> (ProbeBits(c, 2u) & 31u)) | 1u;
    const uint2 pair = DivideAndRoundUp(uint2(a >> 1u, a >> 3u), uint2(b, (b >> 1u) | 1u));
    const uint3 triple = DivideAndRoundUp(uint3(a, b, a ^ b), uint3(b | 2u, 5u, 9u));
    return uint4(DivideAndRoundUp(a, b), pair, triple.x + triple.y + triple.z);
}

uint4 GroupCoordinatesCase(uint s, uint c) {
    const uint linearGroup = ProbeBits(c, 0u);
    const uint perRow = ProbeBits(c, 1u) % 1000u + 1u;
    const uint2 tile = TileOrigin2D(linearGroup & 0xffffu, perRow, 8u);
    const uint4 tiles = uint4(UnflattenGroupId2D(linearGroup, perRow), tile);
    const uint2 morton = GroupThreadMortonCoordinate(c % 4096u);
    const uint linearThread = LinearThreadIndex(uint3(c % 8u, (c / 8u) % 8u, (c / 64u) % 16u), uint3(8u, 8u, 16u));
    const uint wrapped = UnwrapLinearGroupId(uint3(ProbeBits(c, 0u) % 65535u, ProbeBits(c, 1u) % 65535u, 0u));
    return s == 0u ? tiles : uint4(morton, linearThread, wrapped);
}

uint4 DispatchArgumentsCase(uint c) {
    const uint special = ProbeDispatchSpecialThreads[min(c, 7u)];
    const uint threads = c < 8u ? special : ProbeBits(c, 0u) >> (ProbeBits(c, 2u) % 32u);
    const uint groupSize = c < 8u ? 64u : ProbeBits(c, 1u) % 1024u + 1u;
    const uint unwrapped = UnwrapDispatchThreadId(uint3(ProbeBits(c, 3u) % 65535u, ProbeBits(c, 4u) % 65u, 0u),
                                                  ProbeBits(c, 5u) % 64u, 64u);
    return uint4(DispatchArgumentsForThreads(threads, groupSize), unwrapped);
}

uint4 EvaluateDispatchCase(uint f, uint s, uint c) {
    uint4 result = uint4(0u, 0u, 0u, 0u);
    if (f == ProbeDivideRoundUp) {
        result = DivideRoundUpCase(c);
    } else if (f == ProbeGroupCoordinates) {
        result = GroupCoordinatesCase(s, c);
    } else {
        result = DispatchArgumentsCase(c);
    }

    return result;
}

[numthreads(64, 1, 1)]
void ComputeDispatchProbe(uint3 dispatchThreadId : SV_DispatchThreadID) {
    const uint c = dispatchThreadId.x;
    if (c < ProbeWidth()) {
        ProbeRecords[c] = EvaluateDispatchCase(ProbeFunction(), ProbeSelector(), c);
    }
}

[numthreads(1, 1, 1)]
void WrappedDispatchProbe(uint3 groupId : SV_GroupID) {
    const uint linearGroup = UnwrapLinearGroupId(groupId);
    if (linearGroup < ProbeWidth()) {
        InterlockedAdd(GroupCounts[linearGroup], 1u);
    }
}

[numthreads(1, 1, 1)]
void WriteDispatchArgumentsProbe() {
    WriteDispatchArguments(ProbeArguments, Probe.control.z, DispatchArgumentsForThreads(ProbeWidth(), 1u));
}

#else

#if PROBE_GROUP_SIZE == 0
#define GROUP_OPERATION_THREADS 64
#elif PROBE_GROUP_SIZE == 1
#define GROUP_OPERATION_THREADS 256
#else
#define GROUP_OPERATION_THREADS 100
#endif

#define GROUP_OPERATION_FORCE_GROUPSHARED PROBE_FORCE_GROUPSHARED
#include "/Engine/Private/Common/WaveOperations.rsh"

// 그룹 번호 mod 4의 float 입력 모양이다: 0 임의 부호, 1 양수 + −0, 2 ±0만, 3 임의 부호 + −0.
static const uint ProbeFloatModes = 4u;
// 스레드 7개마다 하나가 −0이다(모양 1–3).
static const uint ProbeNegativeZeroPeriod = 7u;
static const uint ProbeNegativeZeroPhase = 3u;
static const uint ProbeRecordsPerThread = 3u;
static const uint ProbeNoWave = 0xffffffffu;

[numthreads(GROUP_OPERATION_THREADS, 1, 1)]
void GroupOperationsProbe(uint3 groupId : SV_GroupID, uint groupIndex : SV_GroupIndex) {
    const uint c = groupId.x * GroupOperationThreads + groupIndex;
    const uint value = ProbeBits(c, 0u);
    const uint mode = groupId.x % ProbeFloatModes;
    float f = ProbeSigned(c, 1u, 4);
    f = mode == 1u ? abs(f) : f;
    f = mode == 2u ? 0.0 : f;
    // −0은 상수 bit(control.z = 0x80000000)로 받는다 — FXC가 리터럴 −0을 +0으로 접는다.
    f = mode != 0u && c % ProbeNegativeZeroPeriod == ProbeNegativeZeroPhase ? asfloat(Probe.control.z) : f;
    const uint4 integers = uint4(GroupSumUint(value, groupIndex), GroupMinUint(value, groupIndex),
                                 GroupMaxUint(value, groupIndex), GroupPrefixSumUint(value, groupIndex));
    const uint4 floats = uint4(asuint(GroupSumFloat(f, groupIndex)), asuint(GroupMinFloat(f, groupIndex)),
                               asuint(GroupMaxFloat(f, groupIndex)), GroupBroadcastFirstUint(value, groupIndex));
    uint4 layout = uint4(asuint(GroupBroadcastFirstFloat(f, groupIndex)), ProbeNoWave, ProbeNoWave, groupIndex);
#if ROCKS_FEATURE_WAVE_OPERATIONS
    layout.y = WaveGetLaneIndex() | (WaveGetLaneCount() << 16);
    layout.z = WaveReadLaneFirst(groupIndex);
#endif
    ProbeRecords[c * ProbeRecordsPerThread] = integers;
    ProbeRecords[c * ProbeRecordsPerThread + 1u] = floats;
    ProbeRecords[c * ProbeRecordsPerThread + 2u] = layout;
}

#endif
