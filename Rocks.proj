<Project DefaultTargets="Build">
  <PropertyGroup>
    <RocksRoot>$(MSBuildThisFileDirectory)</RocksRoot>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <RocksTarget Condition="'$(RocksTarget)' == ''">Foundation</RocksTarget>
    <SdkTarget Condition="'$(SdkTarget)' == ''">Engine</SdkTarget>
    <GameTarget Condition="'$(GameTarget)' == ''">Game</GameTarget>
    <!-- Configurations of the installed SDK (Docs/Design/ProjectFiles.ko.md 10.3), joined with '+': -p:SdkConfigurations=Debug+Release.
         MSBuild reads ',' and ';' in -p: as property separators. -->
    <SdkConfigurations Condition="'$(SdkConfigurations)' == ''">Debug+Development+Release</SdkConfigurations>
    <Jobs Condition="'$(Jobs)' == ''">8</Jobs>
    <!-- Directory values passed in quotes get a doubled trailing backslash. Passing a drive root (Z:\) as "Z:\" makes \" read as a quote escape
         (CommandLineToArgvW rules), and all following arguments join into one argument. "Z:\\" reads as a single Z:\. -->
    <NativeOutputText>$(NativeOutput)</NativeOutputText>
    <NativeOutputText Condition="$(NativeOutput.EndsWith('\'))">$(NativeOutput.TrimEnd('\'))\\</NativeOutputText>
    <AndroidNdkText>$(AndroidNdk)</AndroidNdkText>
    <AndroidNdkText Condition="$(AndroidNdk.EndsWith('\'))">$(AndroidNdk.TrimEnd('\'))\\</AndroidNdkText>
    <SdkDestinationText>$(SdkDestination)</SdkDestinationText>
    <SdkDestinationText Condition="$(SdkDestination.EndsWith('\'))">$(SdkDestination.TrimEnd('\'))\\</SdkDestinationText>
    <SdkDirectoryText>$(SdkDirectory)</SdkDirectoryText>
    <SdkDirectoryText Condition="$(SdkDirectory.EndsWith('\'))">$(SdkDirectory.TrimEnd('\'))\\</SdkDirectoryText>
    <GameDirectoryText>$(GameDirectory)</GameDirectoryText>
    <GameDirectoryText Condition="$(GameDirectory.EndsWith('\'))">$(GameDirectory.TrimEnd('\'))\\</GameDirectoryText>
    <!-- Without SdkDirectory the game build picks the SDK from engineAssociation or the SDK registry (Docs/Design/ProjectFiles.ko.md 10.1). -->
    <SdkArgument Condition="'$(SdkDirectory)' != ''">--sdk &quot;$(SdkDirectoryText)&quot;</SdkArgument>
    <CompilerArgument Condition="'$(Compiler)' != ''">--compiler &quot;$(Compiler)&quot;</CompilerArgument>
    <OutputArgument Condition="'$(NativeOutput)' != ''">--output &quot;$(NativeOutputText)&quot;</OutputArgument>
    <Tool>dotnet &quot;$(RocksRoot)out/dotnet/bin/Rocks.Build.Cli/Debug/net10.0/Rocks.Build.Cli.dll&quot;</Tool>
    <!-- Android cross build: -p:RocksPlatform=android [-p:AndroidAbi=arm64|x86_64] [-p:AndroidApi=26] [-p:AndroidNdk=path] [-p:Adb=path] -->
    <PlatformArgument Condition="'$(RocksPlatform)' != ''">--platform $(RocksPlatform)</PlatformArgument>
    <PlatformArgument Condition="'$(AndroidAbi)' != ''">$(PlatformArgument) --android-abi $(AndroidAbi)</PlatformArgument>
    <PlatformArgument Condition="'$(AndroidApi)' != ''">$(PlatformArgument) --android-api $(AndroidApi)</PlatformArgument>
    <PlatformArgument Condition="'$(AndroidNdk)' != ''">$(PlatformArgument) --android-ndk &quot;$(AndroidNdkText)&quot;</PlatformArgument>
    <PlatformArgument Condition="'$(Adb)' != ''">$(PlatformArgument) --adb &quot;$(Adb)&quot;</PlatformArgument>
    <!-- Build mode (Docs/Design/UnityBuildPch.ko.md section 11): -p:Unity=on|off -p:Pch=on|off -p:Adaptive=on|off. The defaults are on.
         CI passes -p:Adaptive=off (no working file separation); the verification variant is -p:Unity=off -p:Pch=off. -->
    <BuildModeArguments Condition="'$(Unity)' != ''">--unity $(Unity)</BuildModeArguments>
    <BuildModeArguments Condition="'$(Pch)' != ''">$(BuildModeArguments) --pch $(Pch)</BuildModeArguments>
    <BuildModeArguments Condition="'$(Adaptive)' != ''">$(BuildModeArguments) --adaptive $(Adaptive)</BuildModeArguments>
    <!-- -p:Timing=on adds clang -ftime-trace to compile and PCH actions and writes out/<...>/Timing/<target>.timing.json (section 12). -->
    <BuildModeArguments Condition="'$(Timing)' != ''">$(BuildModeArguments) --timing $(Timing)</BuildModeArguments>
    <!-- -p:RequireVerifiedToolchain=on rejects compilers outside Build/Toolchain.json's verified list (CI sets it as a job environment variable). -->
    <BuildModeArguments Condition="'$(RequireVerifiedToolchain)' != ''">$(BuildModeArguments) --require-verified-toolchain $(RequireVerifiedToolchain)</BuildModeArguments>
    <CommonArguments>--root &quot;$(RocksRoot).&quot; --configuration $(Configuration) --jobs $(Jobs) $(CompilerArgument) $(OutputArgument) $(PlatformArgument) $(BuildModeArguments)</CommonArguments>
  </PropertyGroup>
  <!-- MSBuild orchestrates the host tools, rules and stages. Rocks.Build decides C++ up-to-dateness on every invocation. -->
  <!-- Builds the tools only when their inputs changed, under the same lock as Visual Studio builds (Build/Tools.ps1,
       Docs/Design/ProjectFiles.ko.md section 7.2). The build steps below run outside that lock. -->
  <Target Name="BootstrapTools">
    <Exec Command="pwsh -NoLogo -NoProfile -ExecutionPolicy Bypass -File &quot;$(RocksRoot)Build/Tools.ps1&quot;" />
  </Target>
  <Target Name="Build" DependsOnTargets="BootstrapTools">
    <Exec Command="$(Tool) build $(CommonArguments) --target $(RocksTarget)" />
  </Target>
  <Target Name="Test" DependsOnTargets="BootstrapTools">
    <Exec Command="$(Tool) test $(CommonArguments) --target $(RocksTarget)" />
  </Target>
  <!-- Downloads prebuilt binaries (manifest kind: binary) into the per-user store. Build and Test do not download them (Build/README.md). -->
  <Target Name="ThirdPartyBootstrap" DependsOnTargets="BootstrapTools">
    <Exec Command="$(Tool) bootstrap --root &quot;$(RocksRoot).&quot;" />
  </Target>
  <Target Name="InstalledSdk" DependsOnTargets="BootstrapTools">
    <Warning Condition="'$(Configuration)' != 'Debug'" Text="InstalledSdk ignores Configuration=$(Configuration); the SDK configurations come from SdkConfigurations ($(SdkConfigurations))." />
    <Error Condition="'$(SdkDestination)' == ''" Text="SdkDestination is required; use a new versioned directory." />
    <Exec Command="$(Tool) sdk --root &quot;$(RocksRoot).&quot; --configurations $(SdkConfigurations) --jobs $(Jobs) $(CompilerArgument) $(OutputArgument) $(PlatformArgument) $(BuildModeArguments) --target $(SdkTarget) --destination &quot;$(SdkDestinationText)&quot;" />
  </Target>
  <Target Name="Game" DependsOnTargets="BootstrapTools">
    <Error Condition="'$(GameDirectory)' == ''" Text="GameDirectory is required." />
    <Exec Command="$(Tool) game --target $(GameTarget) $(SdkArgument) --project &quot;$(GameDirectoryText)&quot; --configuration $(Configuration) --jobs $(Jobs) $(CompilerArgument) $(OutputArgument) $(BuildModeArguments)" />
  </Target>
</Project>
