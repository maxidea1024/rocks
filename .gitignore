# Generated build and local state
/Build/Artifacts/
/Build/Cache/
/Binaries/
/Intermediate/
# Engine-only asset nuggets (engine shaders without a project — Docs/Design/ShaderSystem section 10)
/Engine/Intermediate/
# Engine-only cooks (asset-cook --engine — Docs/Design/AssetSystem section 10.3 item 7) and their cook root locks
/Engine/Saved/
/Saved/
/out/
# Visual Studio solution written by Rocks.Build.Cli projectfiles (Docs/Design/ProjectFiles.ko.md)
/Rocks.slnx
/.vs/
/.idea/
*.user
*.suo
*.VC.db
*.VC.VC.opendb
.DS_Store
Thumbs.db

# Local secrets and credentials
.env
.env.*
!.env.example
*.pfx
*.p12
*.pem
*.key

# VS Code extension dependencies and build output (Docs/Design/SparksTools.ko.md section 12.1)
/Tools/VSCode/*/node_modules/
/Tools/VSCode/*/out/

# Python tool caches
__pycache__/
*.py[cod]

# clang coverage raw profiles written to the working directory (Build/MeasureCoverage.ps1 runs)
*.profraw
