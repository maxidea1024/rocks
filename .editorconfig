root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# C# (build tools, MetaCompiler, tool tests, module rules) follows the Microsoft C# coding conventions (.NET runtime style).
# Allman braces, braces even for single-line bodies, a blank line after blocks, one statement per line. Rocks.ToolTests format checks
# all C# projects of the repository at once with `dotnet format Build/Format/Rocks.Format.slnx --verify-no-changes --severity warn`
# (whitespace formatting reports as WHITESPACE, the style rules below by IDE ID). It also checks that every .cs in the repository belongs to a project
# of that solution (module and target rules are in Build/Rules, game template rules in the Build/Format project), and `--write` fixes them.
[*.cs]
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_preserve_single_line_statements = false
csharp_preserve_single_line_blocks = true
csharp_prefer_braces = true:warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_style_allow_multiple_blank_lines_experimental = false:warning
dotnet_diagnostic.IDE2000.severity = warning
dotnet_style_allow_statement_immediately_after_block_experimental = false:warning
dotnet_diagnostic.IDE2003.severity = warning
csharp_style_allow_embedded_statements_on_same_line_experimental = false:warning
dotnet_diagnostic.IDE2001.severity = warning
csharp_style_allow_blank_lines_between_consecutive_braces_experimental = false:warning
dotnet_diagnostic.IDE2002.severity = warning

# External library sources (<root>/<Lib>/<lib>-<version>/, where the roots are Core/Source/ThirdParty and Engine/Source/ThirdParty) are kept
# byte for byte. All rules are unset so editors do not change whitespace or line endings. The SHA-256 in ThirdParty.json verifies the sources are preserved.
[{Core,Engine}/Source/ThirdParty/*/*/**]
charset = unset
end_of_line = unset
indent_style = unset
indent_size = unset
tab_width = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

# Offline tool build scripts of prebuilt binaries (Engine/Source/ThirdParty/<Lib>/Build/) are written by Rocks, so the default
# rules (UTF-8, LF, final newline) are restored. Later sections override earlier ones.
[Engine/Source/ThirdParty/*/Build/**]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
tab_width = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Patches of traceable modifications (<root>/<Lib>/*.patch, and <Lib>/Build/*.patch of tool builds) break if trailing whitespace is trimmed,
# because empty context lines are a single space. Line endings stay LF (the check rejects CR); only whitespace trimming is turned off.
[{Core,Engine}/Source/ThirdParty/*/*.patch]
trim_trailing_whitespace = false

[Engine/Source/ThirdParty/*/Build/*.patch]
trim_trailing_whitespace = false
