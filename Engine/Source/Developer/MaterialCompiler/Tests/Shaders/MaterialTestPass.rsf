// 머티리얼 생성 원문 컴파일 확인용 시험 pass다(Docs/Design/MaterialSystem 7.8절 MS2 완료). job마다
// /Engine/Generated/Material.rsh가 머티리얼 생성 원문으로 이어진다(MSR3). 문맥 구조체는 실행 값(정점 번호·
// 픽셀 위치)으로 채우고
// 7.3절 함수를 모두 불러 결과를 출력에 모은다(값을 실행하지 않는 컴파일 확인 — 하위 컴파일러가 지우지
// 않게). MATERIAL_TEST_SUPPLY_ALL이 1이면 공급 표지를 모두 켜 문맥 값 접근자의 공급 경로를, 0이면 UE
// 기본값 경로를 컴파일한다. 공급 경로가 부르는 pass 함수(MaterialPass<이름>)는 시험이 문맥 값 표에서 만든
// 0 값 stub 매크로를 생성 원문 앞에 붙여 준다.
#ifndef MATERIAL_TEST_SUPPLY_ALL
#define MATERIAL_TEST_SUPPLY_ALL 0
#endif

#if MATERIAL_TEST_SUPPLY_ALL
#define MATERIAL_SUPPLY_VIEW 1
#define MATERIAL_SUPPLY_VERTEX 1
#define MATERIAL_SUPPLY_PRIMITIVE 1
#define MATERIAL_SUPPLY_SKIN 1
#define MATERIAL_SUPPLY_LIGHTMAP 1
#define MATERIAL_SUPPLY_LIGHT 1
#define MATERIAL_SUPPLY_SKY 1
#define MATERIAL_SUPPLY_POST_PROCESS 1
#define MATERIAL_SUPPLY_SCENE 1
#define MATERIAL_SUPPLY_DECAL 1
#define MATERIAL_SUPPLY_PARTICLE 1
#define MATERIAL_SUPPLY_DISTANCE_FIELD 1
#define MATERIAL_SUPPLY_HAIR 1
#define MATERIAL_SUPPLY_WATER 1
#define MATERIAL_SUPPLY_VOLUME 1
#define MATERIAL_SUPPLY_RUNTIME_VIRTUAL_TEXTURE 1
#define MATERIAL_SUPPLY_MESH_PAINT 1
#define MATERIAL_SUPPLY_PHYSICS_FIELD 1
#define MATERIAL_SUPPLY_SPEED_TREE 1
#define MATERIAL_SUPPLY_NEURAL 1
#define MATERIAL_SUPPLY_FIRST_PERSON 1
#define MATERIAL_SUPPLY_XR 1
#define MATERIAL_SUPPLY_PATH_TRACING 1
#define MATERIAL_SUPPLY_USER_INTERFACE 1
#endif

#include "/Engine/Private/Material/MaterialCommon.rsh"

float4 MaterialTestVertex(uint vertexId : SV_VertexID) : SV_Position {
    // 입력은 실행 값이다(상수면 FXC가 접어 상수 경고를 낸다 — 실제 pass처럼).
    MaterialVertexInputs inputs = (MaterialVertexInputs)float(vertexId);
    MaterialVertexResult current = (MaterialVertexResult)0;
    MaterialVertexResult previous = (MaterialVertexResult)0;
    EvaluateMaterialVertex(inputs, current);
    EvaluateMaterialVertexPrevious(inputs, previous);
    float3 total = current.worldPositionOffset + previous.worldPositionOffset;
    for (uint index = 0; index < MATERIAL_MAX_TEXCOORDS; ++index) {
        total.xy += current.customizedUvs[index];
    }

    for (uint slot = 0; slot < MATERIAL_MAX_INTERPOLANT_VECTORS; ++slot) {
        total += current.interpolants[slot].xyz;
    }

    return float4(total, float(vertexId));
}

float4 MaterialTestPixel(float4 position : SV_Position) : SV_Target0 {
    MaterialInputs inputs = (MaterialInputs)position.x;
    inputs.svPosition = position;
    inputs.pixelNormal = EvaluateMaterialNormal(inputs);
    const SurfaceAttributes surface = EvaluateMaterialSurface(inputs);
    float4 result = float4(surface.baseColor + surface.emissive + surface.normal +
                               surface.subsurfaceColor + surface.tangent,
                           surface.opacity);
    result.x += surface.metallic + surface.specular + surface.roughness + surface.anisotropy;
    result.y += surface.ambientOcclusion + surface.opacityMask + surface.customData0 +
                surface.customData1 + float(surface.shadingModel);
    result.z += EvaluateMaterialOpacity(inputs) + EvaluateMaterialOpacityMask(inputs) +
                EvaluateMaterialPixelDepthOffset(inputs);
    result += EvaluateMaterialPreview(inputs);
    return result;
}
