const Limit: int = 1;

class Door : ScriptableComponent {
    var Limit: int;
    fn Run(count: int) {
        if (count > 0) {
            let cOUNT = 2;
            _ = cOUNT;
        }
    }
}

open class Base : ScriptableComponent {
