interface Usable {
    fn Use(by: Actor);
    async fn Wait(): int;
}

class Door : ScriptableComponent, Usable {
    fn Use(by: Actor) { }
}

class Gate : ScriptableComponent, Usable {
    fn Use(by: Pawn) { }
    async fn Wait(): int { return 1; }
}

open class Base : ScriptableComponent {
    fn Use(by: Actor) { }
    async fn Wait(): int { return 0; }
}

class Child : Base, Usable { }
