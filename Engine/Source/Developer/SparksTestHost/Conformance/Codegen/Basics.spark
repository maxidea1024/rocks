fn Add(a: int, b: int): int {
    return a + b * 2;
}

fn Scale(v: vec3, k: float): vec3 {
    let w = v * k;
    return w + vec3(1.0, 0.0, 0.0);
}

fn Count(limit: int): int {
    var total = 0;
    for (i in 0..<limit) {
        if (i % 2 == 0) {
            continue;
        }

        total += i;
    }

    return total;
}

fn Pick(flag: bool, a: int?, b: int): int {
    if (flag && b > 0) {
        return a ?? b;
    }

    if (let value = a) {
        return value;
    }

    return -b;
}

fn Greet(name: string, n: int): string {
    return "Hello ${name} x${n}";
}
