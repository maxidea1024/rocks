open class Fixture : ScriptableComponent {
    var Level = 1;
    event Ping(n: int);

    fn Raise() {
        Level += 1;
        Log.Info("raised ${Name()} ${Level}");
    }

    fn Send(n: int) {
        emit Ping(n);
    }

    open fn Name(): string {
        return "fixture";
    }
}

fn Twice(n: int): int {
    return n * 2;
}
