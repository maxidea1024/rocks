import Base;

class Door : Fixture {
    var Peer: Fixture?;
    var Seen = 0;

    fn Watch(target: Fixture) {
        Peer = target;
    }

    fn Fire(n: int) {
        Send(Twice(n));
    }

    override fn Name(): string {
        return "door";
    }

    on Peer.Ping(n: int) {
        Seen += n;
        Log.Info("seen ${n}");
    }
}

class Lamp : Fixture {
}
