class Door : ScriptableComponent {
    var Trail = "";
    var Peer: Door?;
    event Moved();

    fn Link(other: Door) {
        Peer = other;
    }

    on Enable() {
        Trail = "${Trail}E";
        emit Moved();
    }

    on Disable() {
        Trail = "${Trail}D";
    }

    on Destroy() {
        Trail = "${Trail}X";
        Log.Info("destroy ${Trail}");
    }

    on Peer.Moved() {
        Log.Info("peer moved");
    }

    fn Shout() {
        emit Moved();
    }

    async fn Linger() {
        await Delay(0.1, Clock.Game);
        Log.Info("lingered");
    }
}

class Heavy : ScriptableComponent {
    on Destroy() {
        var total = 0;
        for (index in 0..<200000) {
            total += index;
        }

        Log.Info("unreachable ${total}");
    }
}
