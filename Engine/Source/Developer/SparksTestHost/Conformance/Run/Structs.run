# Structs: constructor defaults (initializers and zero values), field reads and writes, copy-on-write, enum names, Buf Result.
MakeStats() -> Stats(Level: 1, Name: "anon", Tags: [], Turn: (0, 0, 0, 1), Feeling: Sleepy, Score: 0, Label: "") (17 steps)
Custom(7) -> Stats(Level: 7, Name: "hero", Tags: [], Turn: (0, 0, 0, 1), Feeling: Sleepy, Score: 0, Label: "") (16 steps)
Fresh() -> Player(Info: Stats(Level: 2, Name: "anon", Tags: [], Turn: (0, 0, 0, 1), Feeling: Sleepy, Score: 0, Label: ""), Hp: 100) (21 steps)
LevelUp(3) -> 5099 (36 steps)
Isolated() -> "anon second" (32 steps)
Describe(Calm) -> "Calm!" (6 steps)
Describe(Sleepy) -> "Sleepy!" (6 steps)
Wrap("a") -> ok("a") (5 steps)
Wrap("") -> error(1) (6 steps)
Chain("b") -> ok("b?") (15 steps)
Chain("") -> error(1) (11 steps)
Unwrap("c") -> "c" (10 steps)
Unwrap("") -> ended error(1) (11 steps)
MakePlayer(5) -> ok(Player(Info: Stats(Level: 2, Name: "anon", Tags: [], Turn: (0, 0, 0, 1), Feeling: Sleepy, Score: 0, Label: ""), Hp: 5)) (24 steps)
MakePlayer(-1) -> error(0) (6 steps)
Health(5) -> ok(5) (32 steps)
Health(-1) -> error(0) (11 steps)
Identity() -> (0, 0, 0, 1) (19 steps)
