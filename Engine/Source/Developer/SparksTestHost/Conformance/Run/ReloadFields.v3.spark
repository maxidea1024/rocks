enum Mode {
    Idle,
    Paused,
    Busy
}

struct Stats {
    var Level: int = 1;
    var Bonus: int = 0;
}

class Lamp : ScriptableComponent {
    @edit var Cue: SoundAsset;
    var Count = 100;
    var Spare = 7;
    var Label = "lamp";
    var Kind = "k";
    @formerly("Moniker") var Title = "t";
    var Info = Stats();
    var State = Mode.Idle;
    var Items: Array<int> = [];
    var Hum: LoopHandle?;
    var Swap = 0;
    var Peer: Lamp?;
    var Mate: Beacon?;
    var Ready = 50;
    var Fresh = "new";
    event Ping(n: int);
    event Pong(n: int);

    on Enable() {
        Hum = World.Audio.StartLoop(Cue);
        Ready = 4;
    }

    fn Bump() {
        Count += 1;
    }

    fn Watch(target: Lamp) {
        Peer = target;
    }

    fn Fire(n: int) {
        emit Ping(n);
        emit Pong(n);
    }

    on Peer.Ping(n: int) {
        Log.Info("peer ping v3 ${n}");
    }

    on Mate.Ping(n: int) {
        Log.Info("mate ping v3 ${n}");
    }

    async fn UseCount() {
        await Delay(1.0, Clock.Game);
        Count += 10;
        Log.Info("count ${Count}");
    }
}

class Beacon : ScriptableComponent {
    event Ping(n: int);
}

class Plain : ScriptableComponent {
    var Value = 1;

    fn Touch() {
        Value = 2;
    }
}
