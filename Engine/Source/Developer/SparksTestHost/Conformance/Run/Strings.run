# Strings: interpolation notation, byte-order comparison, string? and buffer lifetime (the ledger is checked after every call).
Greet("Ann", 3) -> "Hello Ann x3" (10 steps)
Greet("", -1) -> "Hello  x-1" (10 steps)
Show((1.0, -2.5, 0.0), 0.1, 0.1, true) -> "(1.0, -2.5, 0.0) 0.1 0.1 true" (16 steps)
Show((1e21, 0.0, 0.0), 3.0, 16777216.0, false) -> "(1e+21, 0.0, 0.0) 3.0 16777216.0 false" (16 steps)
Wide(18446744073709551615, -128, (0.0, 0.0, 0.0, 1.0)) -> "18446744073709551615/-128 (0.0, 0.0, 0.0, 1.0)" (12 steps)
Order("apple", "apricot") -> true (2 steps)
Order("b", "a") -> false (2 steps)
Order("", "a") -> true (2 steps)
Same("x", "x") -> true (2 steps)
Same("x", "y") -> false (2 steps)
Pick(true) -> "yes" (3 steps)
Pick(false) -> none (3 steps)
OrDefault(none) -> "none" (5 steps)
OrDefault("set") -> "set" (5 steps)
Verbatim() -> "C:\\path \"quoted\"" (2 steps)
Repeat("ab", 3) -> "ab0ab1ab2" (48 steps)
Repeat("\x01\t\"", 2) -> "\x01\t\"0\x01\t\"1" (34 steps)
