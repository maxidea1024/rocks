# Scalar tuples: math types, optionals and Scalar Results.
Lift((1.0, 2.0, 3.0), 2.0) -> (2, 4, 7) (16 steps)
Lift((1e308, 0.0, 0.0), 10.0) -> fault NonFinite at 2:12 (1 steps)
Compose((0.0, 0.0, 0.7071067811865476, 0.7071067811865476), (0.0, 0.0, 0.7071067811865476, 0.7071067811865476)) -> (0, 0, 1.0000000000000002, 0) (2 steps)
Maybe(true, 5) -> 5 (4 steps)
Maybe(false, 5) -> none (4 steps)
OrZero(none) -> 0 (5 steps)
OrZero(7) -> 7 (5 steps)
Check(4) -> ok(8) (8 steps)
Check(-1) -> error(2) (7 steps)
Chain(4) -> ok(9) (18 steps)
Chain(-1) -> error(2) (13 steps)
Plain(3) -> 6 (14 steps)
Plain(-1) -> ended error(2) (13 steps)
Done(1) -> ok (5 steps)
Done(0) -> error(10) (6 steps)
