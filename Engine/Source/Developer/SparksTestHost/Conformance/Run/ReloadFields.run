  host AudioSystem.StartLoop(#6, none) -> #11
  host AudioSystem.StartLoop(#6, none) -> #12
hook #3 Enable -> ok (27 steps)
  host AudioSystem.StartLoop(#6, none) -> #13
  host AudioSystem.StartLoop(#6, none) -> #14
  host AudioSystem.StartLoop(#6, none) -> #15
