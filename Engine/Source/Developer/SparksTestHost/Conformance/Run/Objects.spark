class Mover : ScriptableComponent {
    var Steps = 0;
    var Label = "start";
    var Target: Actor?;
    var Hum: LoopHandle?;

    fn Place(actor: Actor, to: vec3): vec3 {
        actor.Location = to;
        Steps += 1;
        return actor.Location;
    }

    fn Remember(actor: Actor?, suffix: string): string {
        Target = actor;
        Label = "${Label}+${suffix}";
        return Label;
    }

    fn Same(other: Actor?): bool {
        return Target == other;
    }

    fn Remove(actor: Actor): bool {
        actor.RequestDestroy();
        let again: Actor? = actor;
        return again == null;
    }

    fn HasTarget(): bool {
        if (let found = Target) {
            return found.HasAuthority || true;
        }

        return false;
    }

    fn Loop(sound: SoundAsset): bool {
        Hum = World.Audio.StartLoop(sound);
        Hum?.Pause();
        return Hum?.IsPlaying() ?? false;
    }

    fn Holder(): Actor {
        return Owner;
    }

    fn Count(): int {
        return Actor.CountAll() + Steps;
    }

    fn Home(): bool {
        let first = Tag("Game.Home");
        let second = Tag("Game.Door");
        return first == second;
    }
}

open class Speaker : ScriptableComponent {
    open fn Speak(): string {
        return "base";
    }
}

class Loud : Speaker {
    override fn Speak(): string {
        return "LOUD";
    }
}

class Talker : ScriptableComponent {
    fn Talk(other: Speaker): string {
        return other.Speak();
    }

    fn IsPawn(actor: Actor): bool {
        if (let pawn = actor as? Pawn) {
            return pawn.HasAuthority || true;
        }

        return false;
    }

    fn Echo(pawn: Pawn): Pawn {
        return pawn;
    }

    fn Named(): string {
        let home = Tag("Game.Home");
        return "${home}";
    }

    fn Spawned(): int {
        let spawn = SpawnParams(Count: 2, Category: Tag("Game.Spawn"));
        return spawn.Count + 3;
    }
}
