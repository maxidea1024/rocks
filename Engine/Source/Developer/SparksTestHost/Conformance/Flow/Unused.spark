enum Mode { A, B }

interface Usable {
    fn Use(user: Actor);
}

open class Base : ScriptableComponent {
    event Struck(amount: int);

    open fn Step(_: int) {
    }

    open fn Hop(height: float) {
    }
}

class Unused : Base, Usable {
    var Flag = false;
    var Total = 0;
    var Kind = Mode.A;
    var Items: Array<int> = [];
    var Scores: Map<string, int> = [];

    override fn Step(_: int) {
    }

    override fn Hop(height: float) {
    }

    fn Use(_: Actor) {
    }

    on Struck(amount: int) {
    }

    on Owner.Damaged(_: float) {
    }

    fn Plain(value: int, _: int) {
    }

    fn Reads(value: int) {
        Total = value;
    }

    fn Find(): Actor? {
        return Owner;
    }

    fn Locals() {
        var unused = 1;
        let alsoUnused = 2;
        var onlyWritten = 0;
        onlyWritten = 1;
        var point = vec3(0.0, 0.0, 0.0);
        point.X = 1.0;
        var list: Array<int> = [];
        list.Add(1);
        let me = Owner;
        me.Location = vec3(0.0, 0.0, 0.0);
        for (item in Items) {
        }

        for (_ in Items) {
            Total += 1;
        }

        for (key, value in Scores) {
            Total += value;
        }

        for (index, _ in Items) {
            Total += index;
        }

        for (turn in 0..<3) {
        }

        if (let found = Find()) {
        }

        let required = Find() ?? return;
    }

    fn DeadRead() {
        let late = 3;
        return;
        Total = late;
    }

    fn Stores() {
        var a = 1;
        a = 2;
        a = 3;
        Total = a;

        var b = 1;
        b = 2;
        Total = b;

        var c = 1;
        Total = c;
        c = 5;

        var d = 0;
        if (Flag) {
            d = 1;
        } else {
            d = 2;
        }

        Total = d;

        var e = 0;
        if (Flag) {
            e = 1;
        }

        e = 2;
        Total = e;

        var i = 0;
        while (i < 3) {
            i += 1;
        }

        var j = 0;
        while (Flag) {
            Total = j;
            j = 1;
        }

        var s = 0;
        s = 5;
        s += 1;
        Total = s;

        var q = vec3(0.0, 0.0, 0.0);
        q.X = 1.0;
        q.Y = 2.0;
        _ = q;

        var m = 0;
        while (Flag) {
            m = 1;
            break;
        }

        Total = m;

        var r = 0;
        switch (Kind) {
            case Mode.A: {
                r = 1;
            }
            case Mode.B: {
                r = 2;
            }
        }

        Total = r;

        var late = 0;
        Total = late;
        return;
        late = 3;
    }

    fn Copies() {
        var location = Owner.Location;
        _ = location;
        location.Z += 1.0;
        var back = Owner.Location;
        back.Z += 1.0;
        Owner.Location = back;
    }

    fn Elements() {
        var list: Array<int> = [1, 2];
        _ = list;
        list[0] = 3;
        var kept: Array<int> = [1];
        kept[0] = 2;
        _ = kept;
    }

    fn Parenthesized() {
        var paren = vec3(0.0, 0.0, 0.0);
        _ = paren;
        (paren).X = 1.0;
    }

    fn Broken(x: int) {
        var y = 1;
        _ = Missing;
    }

    fn DescribeState(detailed: bool): string {
        return "";
    }
}

