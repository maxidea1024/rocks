fn Valid(i: int, j: int32, u: uint64, g: float32, f: float) {
    _ = float(i);
    _ = float32(i);
    _ = int(j);
    _ = int32(i);
    _ = uint8(u);
    _ = float(g);
    _ = float32(f);
    _ = int8(100);
    _ = uint8(255);
    _ = float(1);
    _ = float32(1.5);
    _ = int(-5);
    _ = uint64(18446744073709551615);
}

fn Errors(i: int, f: float, flag: bool, text: string, v: vec3, opt: int?) {
    _ = int(1.5);
    _ = int(f);
    _ = uint8(f);
    _ = int8(300);
    _ = uint8(-1);
    _ = float32(1e39);
    _ = float32(true);
    _ = float(text);
    _ = float(v);
    _ = int(opt);
    _ = bool(1);
    _ = string(i);
    _ = int(1, 2);
    _ = int();
    _ = int(value: 1);
    _ = float(Missing);
}
