fn Valid(items: Array<int>, scores: Map<string, float>, i: int, names: Array<string>) {
    let first = items[0];
    let byIndex = items[i];
    let score = scores["Red"];
    items[1] = 5;
    scores["Blue"] = 2.0;
    _ = first ?? 0;
    _ = byIndex;
    _ = score ?? 0.0;
    _ = names[0]?.Length;
}

fn Errors(items: Array<int>, scores: Map<string, float>, names: Set<string>, text: string,
          f: float, maybe: Array<int>?) {
    _ = items["a"];
    _ = items[f];
    _ = scores[1];
    _ = names[0];
    _ = text[0];
    _ = maybe[0];
    items[0] = "a";
    scores["a"] = 1;
    _ = items[0] + 1;
}
