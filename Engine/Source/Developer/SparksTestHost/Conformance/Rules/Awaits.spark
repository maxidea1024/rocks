fn Plain() {
    await NextTick();
    let n = try await Fetch();
    _ = n;
}

async fn Fetch(): Result<int> {
    await NextTick();
    return 1;
}

enum Mode { A, B }

class Flows : ScriptableComponent {
    async fn Nothing() {
    }

    async fn Wait() {
        await NextTick();
    }

    async fn Loops(flag: bool, mode: Mode) {
        while (flag) {
            await NextTick();
        }

        while (flag) {
            if (flag) {
                await NextTick();
            } else {
                break;
            }
        }

        while (true) {
            if (flag) {
                return;
            }

            await NextTick();
        }

        while (flag) {
            if (flag) {
                continue;
            }

            await NextTick();
        }

        while (flag) {
            if (flag) {
                await NextTick();
            }
        }

        while (flag) {
            for (i in 0..<3) {
                _ = i;
                await NextTick();
            }
        }

        while (flag) {
            switch (1) {
                case 1: {
                    await NextTick();
                }
                default: {
                    await NextTick();
                }
            }
        }

        while (flag) {
            switch (mode) {
                case Mode.A: {
                    await NextTick();
                }
                case Mode.B: {
                    await NextTick();
                }
            }
        }
    }

    async fn Hollow(flag: bool) {
        while (flag) {
            await Nothing();
        }

        while (flag) {
            await Wait();
        }

        while (flag) {
            for (i in 0..<3) {
                _ = i;
                continue;
            }

            await NextTick();
        }
    }
}

async fn TopWait() {
    await NextTick();
}

fn TopEmit(a: Actor) {
    a.RequestDestroy();
    _ = a.GetForwardVector();
}

fn Counting(flag: bool) {
    while (flag) {
    }
}

class Door : ScriptableComponent {
    var Flag = false;

    on Tick() {
        while (Flag) {
        }
    }

    on Start() {
        while (Flag) {
            await NextTick();
        }
    }
}
