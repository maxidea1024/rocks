diff --git a/source/common/cstring.h b/source/common/cstring.h
index 3a14e42..f30f8ba 100644
--- a/source/common/cstring.h
+++ b/source/common/cstring.h
@@ -33,16 +33,47 @@
 #include <stdlib.h>
 #include <ctype.h>
 
-#define uprv_strcpy(dst, src) U_STANDARD_CPP_NAMESPACE  strcpy(dst, src)
+#define uprv_strcpy(dst, src) uprv_rocksStrcpy(dst, src)
 #define uprv_strlen(str) U_STANDARD_CPP_NAMESPACE strlen(str)
 #define uprv_strcmp(s1, s2) U_STANDARD_CPP_NAMESPACE strcmp(s1, s2)
-#define uprv_strcat(dst, src) U_STANDARD_CPP_NAMESPACE strcat(dst, src)
+#define uprv_strcat(dst, src) uprv_rocksStrcat(dst, src)
 #define uprv_strchr(s, c) U_STANDARD_CPP_NAMESPACE strchr(s, c)
 #define uprv_strstr(s, c) U_STANDARD_CPP_NAMESPACE strstr(s, c)
 #define uprv_strrchr(s, c) U_STANDARD_CPP_NAMESPACE strrchr(s, c)
-#define uprv_strncpy(dst, src, size) U_STANDARD_CPP_NAMESPACE strncpy(dst, src, size)
+#define uprv_strncpy(dst, src, size) uprv_rocksStrncpy(dst, src, size)
 #define uprv_strncmp(s1, s2, n) U_STANDARD_CPP_NAMESPACE strncmp(s1, s2, n)
-#define uprv_strncat(dst, src, n) U_STANDARD_CPP_NAMESPACE strncat(dst, src, n)
+#define uprv_strncat(dst, src, n) uprv_rocksStrncat(dst, src, n)
+
+/* Rocks modification (Engine/Source/ThirdParty/Icu/ThirdParty.json "modifications"): the same results as strcpy, strcat,
+ * strncpy and strncat, written with memcpy and strlen because the Microsoft CRT marks those four deprecated and the engine
+ * warning rules reject the deprecation warning. */
+static inline char *uprv_rocksStrcpy(char *dst, const char *src) {
+    U_STANDARD_CPP_NAMESPACE memcpy(dst, src, U_STANDARD_CPP_NAMESPACE strlen(src) + 1);
+    return dst;
+}
+static inline char *uprv_rocksStrcat(char *dst, const char *src) {
+    uprv_rocksStrcpy(dst + U_STANDARD_CPP_NAMESPACE strlen(dst), src);
+    return dst;
+}
+static inline char *uprv_rocksStrncpy(char *dst, const char *src, size_t size) {
+    size_t i = 0;
+    for (; i < size && src[i] != 0; ++i) {
+        dst[i] = src[i];
+    }
+    for (; i < size; ++i) {
+        dst[i] = 0;
+    }
+    return dst;
+}
+static inline char *uprv_rocksStrncat(char *dst, const char *src, size_t n) {
+    char *end = dst + U_STANDARD_CPP_NAMESPACE strlen(dst);
+    size_t i = 0;
+    for (; i < n && src[i] != 0; ++i) {
+        end[i] = src[i];
+    }
+    end[i] = 0;
+    return dst;
+}
 
