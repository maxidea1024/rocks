diff --git a/source/common/ubrk.cpp b/source/common/ubrk.cpp
index c2f95c5..237de89 100644
--- a/source/common/ubrk.cpp
+++ b/source/common/ubrk.cpp
@@ -176,7 +176,20 @@ ubrk_safeClone(
 
 U_CAPI UBreakIterator * U_EXPORT2
 ubrk_clone(const UBreakIterator *bi, UErrorCode *status) {
-    return ubrk_safeClone(bi, nullptr, nullptr, status);
+    // Rocks modification: the body of ubrk_safeClone with no buffer, instead of calling the deprecated function
+    // (-Wdeprecated-declarations under the engine warning rules). Same result and status.
+    if (status == nullptr || U_FAILURE(*status)) {
+        return nullptr;
+    }
+    if (bi == nullptr) {
+        *status = U_ILLEGAL_ARGUMENT_ERROR;
+        return nullptr;
+    }
+    BreakIterator *newBI = ((BreakIterator *)bi)->clone();
+    if (newBI == nullptr) {
+        *status = U_MEMORY_ALLOCATION_ERROR;
+    }
+    return (UBreakIterator *)newBI;
 }
 
 
