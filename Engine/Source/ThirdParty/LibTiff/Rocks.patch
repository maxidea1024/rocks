diff --git a/libtiff/tif_config.h b/libtiff/tif_config.h
new file mode 100644
--- /dev/null
+++ b/libtiff/tif_config.h
@@ -0,0 +1,36 @@
+/* Rocks configuration header for libtiff 4.7.2 (Docs/Design/AssetSystem section 12.10), written by hand in place of the file the
+   libtiff CMake build generates from tif_config.h.cmake.in. Only the entries the imported library sources test are set: the
+   codec switches come from tiffconf.h, fcntl.h supplies the open mode flags _TIFFgetMode uses, and the size_t width selects the
+   printf formats of the library messages. Rocks reads through TIFFClientOpenExt only, so no file I/O configuration is needed. */
+#ifndef ROCKS_TIF_CONFIG_H
+#define ROCKS_TIF_CONFIG_H
+
+#include "tiffconf.h"
+
+#define HAVE_ASSERT_H 1
+#define HAVE_FCNTL_H 1
+
+#define PACKAGE "LibTIFF Software"
+#define PACKAGE_BUGREPORT "tiff@lists.osgeo.org"
+#define PACKAGE_NAME "LibTIFF Software"
+#define PACKAGE_TARNAME "tiff"
+#define PACKAGE_URL ""
+
+#if SIZE_MAX == UINT64_MAX
+#define SIZEOF_SIZE_T 8
+#else
+#define SIZEOF_SIZE_T 4
+#endif
+
+#define WORDS_BIGENDIAN 0
+
+#define TIFF_SIZE_FORMAT "zu"
+#if SIZEOF_SIZE_T == 8
+#define TIFF_SSIZE_FORMAT PRId64
+#elif SIZEOF_SIZE_T == 4
+#define TIFF_SSIZE_FORMAT PRId32
+#else
+#error "Unsupported size_t size"
+#endif
+
+#endif /* ROCKS_TIF_CONFIG_H */
diff --git a/libtiff/tiffconf.h b/libtiff/tiffconf.h
new file mode 100644
--- /dev/null
+++ b/libtiff/tiffconf.h
@@ -0,0 +1,55 @@
+/* Rocks configuration header for libtiff 4.7.2 (Docs/Design/AssetSystem section 12.10), written by hand in place of the file the
+   libtiff CMake build generates from tiffconf.h.cmake.in. Every Rocks target is little endian with IEEE floating point. The codecs
+   are the lossless ones UE 5.8 also enables (CCITT, LZW, NeXT, PackBits, ThunderScan, ZIP through the Rocks zlib) plus JPEG and
+   old JPEG through the Rocks libjpeg-turbo (section 12.11 - UE enables them on Mac and Linux only); PixarLog, SGILog, JBIG, LERC,
+   LZMA, WebP and ZSTD are not built.
+   DEFAULT_EXTRASAMPLE_AS_ALPHA matches UE: a fourth sample without an ExtraSamples value is alpha. */
+#ifndef _TIFFCONF_
+#define _TIFFCONF_
+
+#include <inttypes.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define TIFF_INT16_T int16_t
+#define TIFF_INT32_T int32_t
+#define TIFF_INT64_T int64_t
+#define TIFF_INT8_T int8_t
+#define TIFF_UINT16_T uint16_t
+#define TIFF_UINT32_T uint32_t
+#define TIFF_UINT64_T uint64_t
+#define TIFF_UINT8_T uint8_t
+
+#if SIZE_MAX == UINT64_MAX
+#define TIFF_SSIZE_T int64_t
+#else
+#define TIFF_SSIZE_T int32_t
+#endif
+
+#define HAVE_IEEEFP 1
+#define HOST_FILLORDER FILLORDER_LSB2MSB
+#define HOST_BIGENDIAN 0
+
+#define CCITT_SUPPORT 1
+#define JPEG_SUPPORT 1
+#define LZW_SUPPORT 1
+#define NEXT_SUPPORT 1
+#define OJPEG_SUPPORT 1
+#define PACKBITS_SUPPORT 1
+#define THUNDER_SUPPORT 1
+#define ZIP_SUPPORT 1
+
+#define STRIPCHOP_DEFAULT TIFF_STRIPCHOP
+#define SUBIFD_SUPPORT 1
+#define DEFAULT_EXTRASAMPLE_AS_ALPHA 1
+#define CHECK_JPEG_YCBCR_SUBSAMPLING 1
+#define MDI_SUPPORT 1
+
+#define COLORIMETRY_SUPPORT
+#define YCBCR_SUPPORT
+#define CMYK_SUPPORT
+#define ICC_SUPPORT
+#define PHOTOSHOP_SUPPORT
+#define IPTC_SUPPORT
+
+#endif /* _TIFFCONF_ */
diff --git a/libtiff/tif_rocks.c b/libtiff/tif_rocks.c
new file mode 100644
--- /dev/null
+++ b/libtiff/tif_rocks.c
@@ -0,0 +1,112 @@
+/* Rocks platform layer for libtiff 4.7.2 (Docs/Design/AssetSystem section 12.10), in place of tif_unix.c and tif_win32.c. See
+   tif_rocks.h. The global message handlers stay null: callers receive messages through TIFFOpenOptionsSetErrorHandlerExtR and
+   TIFFOpenOptionsSetWarningHandlerExtR, and nothing is printed. */
+#include "tiffiop.h"
+
+#include "tif_rocks.h"
+
+#include <string.h>
+
+static _Thread_local const RocksTiffAllocator* rocksTiffAllocator = NULL;
+
+/* Every block starts with a header that records the allocator table that made it, so _TIFFfree and
+   _TIFFrealloc work even when the binding has changed (or is gone) by the time the block is
+   released. The header size keeps the user area 16-byte aligned. */
+#define ROCKS_TIFF_HEADER_BYTES 16
+
+typedef struct RocksTiffBlock {
+    const RocksTiffAllocator* allocator;
+} RocksTiffBlock;
+
+static void* rocksTiffUserArea(void* block)
+{
+    return (unsigned char*)block + ROCKS_TIFF_HEADER_BYTES;
+}
+
+static RocksTiffBlock* rocksTiffHeader(void* p)
+{
+    return (RocksTiffBlock*)((unsigned char*)p - ROCKS_TIFF_HEADER_BYTES);
+}
+
+static void* rocksTiffAllocate(size_t bytes)
+{
+    if (rocksTiffAllocator == NULL || bytes > (size_t)TIFF_TMSIZE_T_MAX - ROCKS_TIFF_HEADER_BYTES)
+        return NULL;
+
+    RocksTiffBlock* block = (RocksTiffBlock*)rocksTiffAllocator->allocate(bytes + ROCKS_TIFF_HEADER_BYTES);
+    if (block == NULL)
+        return NULL;
+
+    block->allocator = rocksTiffAllocator;
+    return rocksTiffUserArea(block);
+}
+
+const RocksTiffAllocator* RocksTiffBindAllocator(const RocksTiffAllocator* allocator)
+{
+    const RocksTiffAllocator* previous = rocksTiffAllocator;
+    rocksTiffAllocator = allocator;
+    return previous;
+}
+
+void* _TIFFmalloc(tmsize_t s)
+{
+    /* Like tif_unix.c, a zero size returns null. */
+    if (s <= 0)
+        return NULL;
+
+    return rocksTiffAllocate((size_t)s);
+}
+
+void* _TIFFcalloc(tmsize_t nmemb, tmsize_t siz)
+{
+    if (nmemb <= 0 || siz <= 0)
+        return NULL;
+
+    if (nmemb > TIFF_TMSIZE_T_MAX / siz)
+        return NULL;
+
+    void* p = rocksTiffAllocate((size_t)(nmemb * siz));
+    if (p != NULL)
+        memset(p, 0, (size_t)(nmemb * siz));
+
+    return p;
+}
+
+void _TIFFfree(void* p)
+{
+    if (p == NULL)
+        return;
+
+    RocksTiffBlock* block = rocksTiffHeader(p);
+    block->allocator->release(block);
+}
+
+void* _TIFFrealloc(void* p, tmsize_t s)
+{
+    if (s < 0 || (size_t)s > (size_t)TIFF_TMSIZE_T_MAX - ROCKS_TIFF_HEADER_BYTES)
+        return NULL;
+
+    if (p == NULL)
+        return rocksTiffAllocate((size_t)s);
+
+    /* The block keeps its allocator: reallocate through the table that made it. */
+    RocksTiffBlock* block = rocksTiffHeader(p);
+    const RocksTiffAllocator* allocator = block->allocator;
+    RocksTiffBlock* resized =
+        (RocksTiffBlock*)allocator->reallocate(block, (size_t)s + ROCKS_TIFF_HEADER_BYTES);
+    if (resized == NULL)
+        return NULL;
+
+    resized->allocator = allocator;
+    return rocksTiffUserArea(resized);
+}
+
+void _TIFFmemset(void* p, int v, tmsize_t c) { memset(p, v, (size_t)c); }
+
+void _TIFFmemcpy(void* d, const void* s, tmsize_t c) { memcpy(d, s, (size_t)c); }
+
+int _TIFFmemcmp(const void* p1, const void* p2, tmsize_t c) { return memcmp(p1, p2, (size_t)c); }
+
+TIFFErrorHandler _TIFFwarningHandler = NULL;
+
+TIFFErrorHandler _TIFFerrorHandler = NULL;
diff --git a/libtiff/tif_rocks.h b/libtiff/tif_rocks.h
new file mode 100644
--- /dev/null
+++ b/libtiff/tif_rocks.h
@@ -0,0 +1,31 @@
+/* Rocks platform layer for libtiff 4.7.2 (Docs/Design/AssetSystem section 12.10). tif_rocks.c replaces the upstream platform
+   files tif_unix.c and tif_win32.c: it defines the memory entry points, the global message handlers (none) and no file open
+   functions, so the only way in is TIFFClientOpenExt with caller procedures. Allocation goes to the allocator the caller binds
+   to the current thread; without a binding every allocation fails (no CRT fallback). Each block records the allocator table that
+   made it, so freeing and reallocating do not depend on the binding. */
+#ifndef TIF_ROCKS_H
+#define TIF_ROCKS_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Allocation functions libtiff calls through _TIFFmalloc, _TIFFcalloc, _TIFFrealloc and _TIFFfree. reallocate follows C realloc
+   (a null address allocates, failure keeps the old block). */
+typedef struct RocksTiffAllocator {
+    void* (*allocate)(size_t bytes);
+    void* (*reallocate)(void* address, size_t bytes);
+    void (*release)(void* address);
+} RocksTiffAllocator;
+
+/* Binds allocator to the current thread and returns the previous binding (null for none). Pass the previous binding back to
+   restore it. */
+const RocksTiffAllocator* RocksTiffBindAllocator(const RocksTiffAllocator* allocator);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* TIF_ROCKS_H */
