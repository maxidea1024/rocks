diff --git a/src/jmemrocks.c b/src/jmemrocks.c
new file mode 100644
--- /dev/null
+++ b/src/jmemrocks.c
@@ -0,0 +1,112 @@
+/* Rocks memory manager back end for libjpeg-turbo 3.2.1 (Docs/Design/AssetSystem section 12.11), in place of
+   jmemnobs.c. Allocation goes to the allocator the caller binds to the current thread (RocksJpegBindAllocator in
+   rocksjpeg.h); without a binding every allocation fails (no CRT fallback). Each block records the allocator table
+   that made it, so freeing does not depend on the binding. client_data is not used because libtiff's old JPEG codec
+   stores its own pointer there. Like jmemnobs.c, jpeg_mem_available reports everything requested as available (the
+   image size is already limited by the caller) and there is no backing store. */
+#define JPEG_INTERNALS
+#include "jinclude.h"
+#include "jpeglib.h"
+#include "jmemsys.h"
+#include "rocksjpeg.h"
+
+#include <stdint.h>
+
+static _Thread_local const RocksJpegAllocator* rocksJpegAllocator = NULL;
+
+/* The header keeps the user area 16-byte aligned. */
+#define ROCKS_JPEG_HEADER_BYTES 16
+
+typedef struct RocksJpegBlock {
+  const RocksJpegAllocator* allocator;
+} RocksJpegBlock;
+
+const RocksJpegAllocator* RocksJpegBindAllocator(const RocksJpegAllocator* allocator)
+{
+  const RocksJpegAllocator* previous = rocksJpegAllocator;
+  rocksJpegAllocator = allocator;
+  return previous;
+}
+
+static void* rocksJpegAllocate(size_t bytes)
+{
+  if (rocksJpegAllocator == NULL || bytes > SIZE_MAX - ROCKS_JPEG_HEADER_BYTES)
+    return NULL;
+
+  RocksJpegBlock* block = (RocksJpegBlock*)rocksJpegAllocator->allocate(bytes + ROCKS_JPEG_HEADER_BYTES);
+  if (block == NULL)
+    return NULL;
+
+  block->allocator = rocksJpegAllocator;
+  return (unsigned char*)block + ROCKS_JPEG_HEADER_BYTES;
+}
+
+static void rocksJpegRelease(void* object)
+{
+  if (object == NULL)
+    return;
+
+  RocksJpegBlock* block = (RocksJpegBlock*)((unsigned char*)object - ROCKS_JPEG_HEADER_BYTES);
+  block->allocator->release(block);
+}
+
+GLOBAL(void*)
+jpeg_get_small(j_common_ptr cinfo, size_t sizeofobject)
+{
+  (void)cinfo;
+  return rocksJpegAllocate(sizeofobject);
+}
+
+GLOBAL(void)
+jpeg_free_small(j_common_ptr cinfo, void* object, size_t sizeofobject)
+{
+  (void)cinfo;
+  (void)sizeofobject;
+  rocksJpegRelease(object);
+}
+
+GLOBAL(void*)
+jpeg_get_large(j_common_ptr cinfo, size_t sizeofobject)
+{
+  (void)cinfo;
+  return rocksJpegAllocate(sizeofobject);
+}
+
+GLOBAL(void)
+jpeg_free_large(j_common_ptr cinfo, void* object, size_t sizeofobject)
+{
+  (void)cinfo;
+  (void)sizeofobject;
+  rocksJpegRelease(object);
+}
+
+GLOBAL(size_t)
+jpeg_mem_available(j_common_ptr cinfo, size_t min_bytes_needed, size_t max_bytes_needed,
+                   size_t already_allocated)
+{
+  (void)cinfo;
+  (void)min_bytes_needed;
+  (void)already_allocated;
+  return max_bytes_needed;
+}
+
+GLOBAL(void)
+jpeg_open_backing_store(j_common_ptr cinfo, backing_store_ptr info, long total_bytes_needed)
+{
+  (void)info;
+  (void)total_bytes_needed;
+  ERREXIT(cinfo, JERR_NO_BACKING_STORE);
+}
+
+GLOBAL(long)
+jpeg_mem_init(j_common_ptr cinfo)
+{
+  (void)cinfo;
+  return 0;
+}
+
+GLOBAL(void)
+jpeg_mem_term(j_common_ptr cinfo)
+{
+  (void)cinfo;
+}
diff --git a/src/rocksjpeg.h b/src/rocksjpeg.h
new file mode 100644
--- /dev/null
+++ b/src/rocksjpeg.h
@@ -0,0 +1,64 @@
+/* Rocks interface to libjpeg-turbo 3.2.1 (Docs/Design/AssetSystem section 12.11). libjpeg reports errors with
+   longjmp; these functions keep setjmp and longjmp inside C so that no C++ frame is ever skipped, and they turn the
+   outcome into a plain result code. Memory comes from the allocator bound to the current thread (jmemrocks.c). No
+   message is printed. */
+#ifndef ROCKS_JPEG_H
+#define ROCKS_JPEG_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Allocation functions the memory back end calls (jpeg_get_small and the like). */
+typedef struct RocksJpegAllocator {
+  void* (*allocate)(size_t bytes);
+  void (*release)(void* address);
+} RocksJpegAllocator;
+
+/* Binds allocator to the current thread and returns the previous binding (null for none). */
+const RocksJpegAllocator* RocksJpegBindAllocator(const RocksJpegAllocator* allocator);
+
+/* Outcome of a call. Error is any libjpeg error exit (damaged or unsupported stream, failed allocation - the caller
+   tells them apart), Warning is a recoverable-data warning (treated as damage), ScanLimit is more progressive scans
+   than allowed. */
+typedef enum RocksJpegResult {
+  ROCKS_JPEG_OK = 0,
+  ROCKS_JPEG_ERROR = 1,
+  ROCKS_JPEG_WARNING = 2,
+  ROCKS_JPEG_SCAN_LIMIT = 3
+} RocksJpegResult;
+
+/* Header facts read by jpeg_read_header (require_image TRUE). colorSpace is the libjpeg J_COLOR_SPACE value. */
+typedef struct RocksJpegInfo {
+  unsigned width;
+  unsigned height;
+  int components;
+  int colorSpace;
+  int precision;
+  int lossless;
+  int progressive;
+} RocksJpegInfo;
+
+/* Reads the header of data into info. */
+RocksJpegResult RocksJpegReadInfo(const unsigned char* data, size_t size, RocksJpegInfo* info);
+
+/* Decodes data into pixels (height rows of rowBytes): grayscale writes one byte per texel, otherwise four (R, G, B,
+   255). maxScans limits progressive scans. The integer slow IDCT (JDCT_ISLOW) and the libjpeg default upsampling and
+   block smoothing are used. */
+RocksJpegResult RocksJpegDecode(const unsigned char* data, size_t size, int grayscale, unsigned maxScans,
+                                unsigned char* pixels, size_t rowBytes);
+
+/* Libjpeg colour space values the caller compares against. */
+enum {
+  ROCKS_JPEG_COLOR_GRAYSCALE = 1,
+  ROCKS_JPEG_COLOR_RGB = 2,
+  ROCKS_JPEG_COLOR_YCBCR = 3
+};
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* ROCKS_JPEG_H */
diff --git a/src/rocksjpeg.c b/src/rocksjpeg.c
new file mode 100644
--- /dev/null
+++ b/src/rocksjpeg.c
@@ -0,0 +1,138 @@
+/* Rocks interface to libjpeg-turbo 3.2.1 (Docs/Design/AssetSystem section 12.11). See rocksjpeg.h. */
+#define JPEG_INTERNALS
+#include "jinclude.h"
+#include "jpeglib.h"
+#include "jpegint.h"
+#include "rocksjpeg.h"
+
+#include <setjmp.h>
+
+typedef struct RocksJpegError {
+  struct jpeg_error_mgr manager;
+  jmp_buf jump;
+  RocksJpegResult result;
+} RocksJpegError;
+
+typedef struct RocksJpegProgress {
+  struct jpeg_progress_mgr manager;
+  RocksJpegError* error;
+  unsigned maxScans;
+} RocksJpegProgress;
+
+static void rocksJpegErrorExit(j_common_ptr cinfo)
+{
+  RocksJpegError* error = (RocksJpegError*)cinfo->err;
+  error->result = ROCKS_JPEG_ERROR;
+  longjmp(error->jump, 1);
+}
+
+/* Level -1 is a warning about damaged data that libjpeg recovered from: it stops the decode (UE TurboJPEG fails the
+   same file). Trace messages (level >= 0) are ignored. */
+static void rocksJpegEmitMessage(j_common_ptr cinfo, int msg_level)
+{
+  if (msg_level < 0) {
+    RocksJpegError* error = (RocksJpegError*)cinfo->err;
+    error->result = ROCKS_JPEG_WARNING;
+    longjmp(error->jump, 1);
+  }
+}
+
+static void rocksJpegOutputMessage(j_common_ptr cinfo)
+{
+  (void)cinfo;
+}
+
+/* Limits progressive scans like TurboJPEG TJPARAM_SCANLIMIT. */
+static void rocksJpegProgressMonitor(j_common_ptr cinfo)
+{
+  RocksJpegProgress* progress = (RocksJpegProgress*)cinfo->progress;
+  j_decompress_ptr dinfo = (j_decompress_ptr)cinfo;
+  if (cinfo->is_decompressor && dinfo->input_scan_number > (int)progress->maxScans) {
+    progress->error->result = ROCKS_JPEG_SCAN_LIMIT;
+    longjmp(progress->error->jump, 1);
+  }
+}
+
+static void rocksJpegInitError(RocksJpegError* error)
+{
+  jpeg_std_error(&error->manager);
+  error->manager.error_exit = rocksJpegErrorExit;
+  error->manager.emit_message = rocksJpegEmitMessage;
+  error->manager.output_message = rocksJpegOutputMessage;
+  error->result = ROCKS_JPEG_OK;
+}
+
+RocksJpegResult RocksJpegReadInfo(const unsigned char* data, size_t size, RocksJpegInfo* info)
+{
+  struct jpeg_decompress_struct cinfo;
+  RocksJpegError error;
+  rocksJpegInitError(&error);
+  cinfo.err = &error.manager;
+  if (setjmp(error.jump)) {
+    jpeg_destroy_decompress(&cinfo);
+    return error.result;
+  }
+
+  jpeg_create_decompress(&cinfo);
+  jpeg_mem_src(&cinfo, data, (unsigned long)size);
+  jpeg_read_header(&cinfo, TRUE);
+  info->width = cinfo.image_width;
+  info->height = cinfo.image_height;
+  info->components = cinfo.num_components;
+  info->colorSpace = (int)cinfo.jpeg_color_space;
+  info->precision = cinfo.data_precision;
+  info->lossless = cinfo.master->lossless ? 1 : 0;
+  info->progressive = cinfo.progressive_mode ? 1 : 0;
+  jpeg_destroy_decompress(&cinfo);
+  return ROCKS_JPEG_OK;
+}
+
+RocksJpegResult RocksJpegDecode(const unsigned char* data, size_t size, int grayscale, unsigned maxScans,
+                                unsigned char* pixels, size_t rowBytes)
+{
+  struct jpeg_decompress_struct cinfo;
+  RocksJpegError error;
+  RocksJpegProgress progress;
+  JSAMPARRAY line;
+  /* Locals changed after setjmp are not read on the longjmp path (cinfo lives in memory - its address is taken), so
+     none needs volatile. The error path destroys the decompressor inside C. */
+  rocksJpegInitError(&error);
+  cinfo.err = &error.manager;
+  if (setjmp(error.jump)) {
+    jpeg_destroy_decompress(&cinfo);
+    return error.result;
+  }
+
+  jpeg_create_decompress(&cinfo);
+  progress.manager.progress_monitor = rocksJpegProgressMonitor;
+  progress.error = &error;
+  progress.maxScans = maxScans;
+  cinfo.progress = &progress.manager;
+  jpeg_mem_src(&cinfo, data, (unsigned long)size);
+  jpeg_read_header(&cinfo, TRUE);
+  cinfo.out_color_space = grayscale ? JCS_GRAYSCALE : JCS_RGB;
+  cinfo.dct_method = JDCT_ISLOW;
+  jpeg_start_decompress(&cinfo);
+  line = (*cinfo.mem->alloc_sarray)((j_common_ptr)&cinfo, JPOOL_IMAGE,
+                                    cinfo.output_width * (JDIMENSION)cinfo.output_components, 1);
+  while (cinfo.output_scanline < cinfo.output_height) {
+    unsigned char* destination = pixels + (size_t)cinfo.output_scanline * rowBytes;
+    JDIMENSION column;
+    jpeg_read_scanlines(&cinfo, line, 1);
+    if (grayscale) {
+      for (column = 0; column < cinfo.output_width; ++column)
+        destination[column] = line[0][column];
+    } else {
+      for (column = 0; column < cinfo.output_width; ++column) {
+        destination[column * 4 + 0] = line[0][column * 3 + 0];
+        destination[column * 4 + 1] = line[0][column * 3 + 1];
+        destination[column * 4 + 2] = line[0][column * 3 + 2];
+        destination[column * 4 + 3] = 255;
+      }
+    }
+  }
+
+  jpeg_finish_decompress(&cinfo);
+  jpeg_destroy_decompress(&cinfo);
+  return ROCKS_JPEG_OK;
+}
