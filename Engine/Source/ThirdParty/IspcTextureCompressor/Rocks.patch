+// Rocks: margin of the minor-axis test in compute_axis (see there).
+static const uniform float axis_restart_ratio = 0.5f;
 
+inline void power_iterate(float axis[4], float covar[10], float vec[4], uniform const int powerIterations, uniform int channels)
