@@ -158,6 +158,13 @@ public:
 	/// Uses the read collision cache to determine if 2 bodies are in contact.
 	bool						WereBodiesInContact(const BodyID &inBody1ID, const BodyID &inBody2ID) const;
 
+	/// Rocks modification: sum the non-penetration impulses that the contact solver applied between 2 bodies during the last collision step, as a world space vector acting on inBody2ID (impulse * contact normal per contact point).
+	/// Uses the read collision cache like WereBodiesInContact: StoreAppliedImpulses writes the total lambda of every contact point into the write cache and the step makes it the read cache.
+	/// The cache stores contact normals in the local space of the body with the larger BodyID, so inRotationOfLargerBody must be the current rotation of that body (the same rotation the next step uses to reuse the cache).
+	/// The value is kg m/s when the contact listener leaves the inverse mass scales at 1. Impulses that continuous collision detection applies (JobResolveCCDContacts) are not stored and not included, also when the pair has discrete contacts in the same step.
+	/// Returns false (zero impulse, no contact points) when the pair had no contact manifold, for example when both bodies are asleep.
+	bool						GetAppliedContactImpulse(const BodyID &inBody1ID, const BodyID &inBody2ID, QuatArg inRotationOfLargerBody, Vec3 &outImpulseOnBody2, uint &outNumContactPoints) const;
+
 	/// Get the number of contact constraints that were found
 	uint32						GetNumConstraints() const											{ return min<uint32>(uint32(mNumConstraintsAndNextConstraintOffset.load(memory_order_relaxed)), mMaxConstraints); }
 
diff --git a/Jolt/Physics/PhysicsSystem.h b/Jolt/Physics/PhysicsSystem.h
index b244a516..b805e035 100644
--- a/Jolt/Physics/PhysicsSystem.h
+++ b/Jolt/Physics/PhysicsSystem.h
@@ -5,6 +5,7 @@
 #pragma once
 
 #include <Jolt/Physics/Body/BodyInterface.h>
+#include <Jolt/Physics/Body/BodyLock.h> // Rocks modification: GetAppliedContactImpulse
 #include <Jolt/Physics/Collision/NarrowPhaseQuery.h>
 #include <Jolt/Physics/Collision/ContactListener.h>
 #include <Jolt/Physics/Constraints/ContactConstraintManager.h>
@@ -250,6 +251,20 @@ public:
 	/// - During the ContactListener::OnContactRemoved callback this function can be used to determine if this is the last contact pair between the bodies (function returns false) or if there are other contacts still present (function returns true).
 	bool						WereBodiesInContact(const BodyID &inBody1ID, const BodyID &inBody2ID) const { return mContactManager.WereBodiesInContact(inBody1ID, inBody2ID); }
 
+	/// Rocks modification: world space sum of the non-penetration impulses that the contact solver applied to inBody2ID from inBody1ID during the last collision step of the last PhysicsSystem::Update, see ContactConstraintManager::GetAppliedContactImpulse.
+	/// Call it only when PhysicsSystem::Update is not running (during contact callbacks the read cache still holds the previous step). An Update with a zero time step does not step and leaves the previous value.
+	bool						GetAppliedContactImpulse(const BodyID &inBody1ID, const BodyID &inBody2ID, Vec3 &outImpulseOnBody2, uint &outNumContactPoints) const
+	{
+		BodyLockRead lock(mBodyLockInterfaceLocking, inBody1ID < inBody2ID? inBody2ID : inBody1ID);
+		if (!lock.Succeeded())
+		{
+			outImpulseOnBody2 = Vec3::sZero();
+			outNumContactPoints = 0;
+			return false;
+		}
+		return mContactManager.GetAppliedContactImpulse(inBody1ID, inBody2ID, lock.GetBody().GetRotation(), outImpulseOnBody2, outNumContactPoints);
+	}
