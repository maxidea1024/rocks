diff --git a/Source/astcenc_rocks_log10_table.h b/Source/astcenc_rocks_log10_table.h
new file mode 100644
index 0000000..68bcc05
--- /dev/null
+++ b/Source/astcenc_rocks_log10_table.h
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: Apache-2.0
+// Rocks: generated by Tools/AstcEncoderTables/generate.py (do not edit).
+//
+// Constant replacement for values astc-encoder computes with the platform libm, so the encoder output does not depend
+// on the C runtime (Docs/Design/AssetSystem section 12.17.8). Each value is the correctly rounded float result of the
+// upstream float expression.
+//
+// log10 of the block texel count that astcenc_config_init uses to interpolate the presets.
+
+#ifndef ASTCENC_ROCKS_LOG10_TABLE_H_INCLUDED
+#define ASTCENC_ROCKS_LOG10_TABLE_H_INCLUDED
+
+/**
+ * @brief Return logf(texels) / logf(10.0f) for the texel count of a valid block size, or -1 for any other count.
+ */
+static inline float rocks_log10_texel_count(unsigned int texels)
+{
+	switch (texels)
+	{
+	case 16: return 0x1.344134p+0f;
+	case 20: return 0x1.4d104ep+0f;
+	case 25: return 0x1.65df66p+0f;
+	case 27: return 0x1.6e6ddcp+0f;
+	case 30: return 0x1.7a249ep+0f;
+	case 36: return 0x1.8e69d8p+0f;
+	case 40: return 0x1.9a209ap+0f;
+	case 48: return 0x1.ae65d4p+0f;
+	case 50: return 0x1.b2efb2p+0f;
+	case 60: return 0x1.c734ecp+0f;
+	case 64: return 0x1.ce61dp+0f;
+	case 80: return 0x1.e730e8p+0f;
+	case 100: return 0x1p+1f;
+	case 120: return 0x1.0a229cp+1f;
+	case 125: return 0x1.0c678cp+1f;
+	case 144: return 0x1.144538p+1f;
+	case 150: return 0x1.168a28p+1f;
+	case 180: return 0x1.20acc4p+1f;
+	case 216: return 0x1.2acf62p+1f;
+	default: return -1.0f;
+	}
+}
+
+#endif
