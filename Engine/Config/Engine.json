// Engine branch settings (Docs/Design/ConfigSystem.ko.md). Projects change these in their own Config/Engine.json, using array
// operations ($append, $remove, $clear, $add) for lists.
{
  // Trace channel presets (Docs/Design/TraceSystem.ko.md section 5). --trace=default and trace.enable channels=default use them.
  "TracePresets": {
    "default": ["cpu", "task", "gpu", "frame", "log", "mark", "counter"]
  },
  // Collision profiles (Docs/Design/CollisionData.ko.md section 3): the same profiles as UE 5.8 BaseEngine.ini
  // [/Script/Engine.CollisionProfile] +Profiles. Projects add channels and profiles with array operations ($add).
  "Collision": {
    "profiles": [
      { "name": "NoCollision", "collisionEnabled": "NoCollision", "objectTypeName": "WorldStatic", "canModify": false,
        "customResponses": [{ "channel": "Visibility", "response": "Ignore" }, { "channel": "Camera", "response": "Ignore" }],
        "helpMessage": "No collision" },
      { "name": "BlockAll", "collisionEnabled": "QueryAndPhysics", "objectTypeName": "WorldStatic", "canModify": false,
        "customResponses": [],
        "helpMessage": "WorldStatic object that blocks all actors by default. All new custom channels will use its own default response. " },
      { "name": "OverlapAll", "collisionEnabled": "QueryOnly", "objectTypeName": "WorldStatic", "canModify": false,
        "customResponses": [{ "channel": "WorldStatic", "response": "Overlap" }, { "channel": "Pawn", "response": "Overlap" }, { "channel": "Visibility", "response": "Overlap" }, { "channel": "WorldDynamic", "response": "Overlap" }, { "channel": "Camera", "response": "Overlap" }, { "channel": "PhysicsBody", "response": "Overlap" }, { "channel": "Vehicle", "response": "Overlap" }, { "channel": "Destructible", "response": "Overlap" }],
        "helpMessage": "WorldStatic object that overlaps all actors by default. All new custom channels will use its own default response. " },
      { "name": "BlockAllDynamic", "collisionEnabled": "QueryAndPhysics", "objectTypeName": "WorldDynamic", "canModify": false,
        "customResponses": [],
        "helpMessage": "WorldDynamic object that blocks all actors by default. All new custom channels will use its own default response. " },
      { "name": "OverlapAllDynamic", "collisionEnabled": "QueryOnly", "objectTypeName": "WorldDynamic", "canModify": false,
        "customResponses": [{ "channel": "WorldStatic", "response": "Overlap" }, { "channel": "Pawn", "response": "Overlap" }, { "channel": "Visibility", "response": "Overlap" }, { "channel": "WorldDynamic", "response": "Overlap" }, { "channel": "Camera", "response": "Overlap" }, { "channel": "PhysicsBody", "response": "Overlap" }, { "channel": "Vehicle", "response": "Overlap" }, { "channel": "Destructible", "response": "Overlap" }],
        "helpMessage": "WorldDynamic object that overlaps all actors by default. All new custom channels will use its own default response. " },
      { "name": "IgnoreOnlyPawn", "collisionEnabled": "QueryOnly", "objectTypeName": "WorldDynamic", "canModify": false,
        "customResponses": [{ "channel": "Pawn", "response": "Ignore" }, { "channel": "Vehicle", "response": "Ignore" }],
        "helpMessage": "WorldDynamic object that ignores Pawn and Vehicle. All other channels will be set to default." },
      { "name": "OverlapOnlyPawn", "collisionEnabled": "QueryOnly", "objectTypeName": "WorldDynamic", "canModify": false,
        "customResponses": [{ "channel": "Pawn", "response": "Overlap" }, { "channel": "Vehicle", "response": "Overlap" }, { "channel": "Camera", "response": "Ignore" }],
        "helpMessage": "WorldDynamic object that overlaps Pawn, Camera, and Vehicle. All other channels will be set to default. " },
      { "name": "Pawn", "collisionEnabled": "QueryAndPhysics", "objectTypeName": "Pawn", "canModify": false,
        "customResponses": [{ "channel": "Visibility", "response": "Ignore" }],
        "helpMessage": "Pawn object. Can be used for capsule of any playerable character or AI. " },
      { "name": "Spectator", "collisionEnabled": "QueryOnly", "objectTypeName": "Pawn", "canModify": false,
        "customResponses": [{ "channel": "WorldStatic", "response": "Block" }, { "channel": "Pawn", "response": "Ignore" }, { "channel": "Visibility", "response": "Ignore" }, { "channel": "WorldDynamic", "response": "Ignore" }, { "channel": "Camera", "response": "Ignore" }, { "channel": "PhysicsBody", "response": "Ignore" }, { "channel": "Vehicle", "response": "Ignore" }, { "channel": "Destructible", "response": "Ignore" }],
        "helpMessage": "Pawn object that ignores all other actors except WorldStatic." },
      { "name": "CharacterMesh", "collisionEnabled": "QueryOnly", "objectTypeName": "Pawn", "canModify": false,
        "customResponses": [{ "channel": "Pawn", "response": "Ignore" }, { "channel": "Vehicle", "response": "Ignore" }, { "channel": "Visibility", "response": "Ignore" }],
        "helpMessage": "Pawn object that is used for Character Mesh. All other channels will be set to default." },
      { "name": "PhysicsActor", "collisionEnabled": "QueryAndPhysics", "objectTypeName": "PhysicsBody", "canModify": false,
        "customResponses": [],
        "helpMessage": "Simulating actors" },
      { "name": "Destructible", "collisionEnabled": "QueryAndPhysics", "objectTypeName": "Destructible", "canModify": false,
        "customResponses": [],
        "helpMessage": "Destructible actors" },
      { "name": "InvisibleWall", "collisionEnabled": "QueryAndPhysics", "objectTypeName": "WorldStatic", "canModify": false,
        "customResponses": [{ "channel": "Visibility", "response": "Ignore" }],
        "helpMessage": "WorldStatic object that is invisible." },
      { "name": "InvisibleWallDynamic", "collisionEnabled": "QueryAndPhysics", "objectTypeName": "WorldDynamic", "canModify": false,
        "customResponses": [{ "channel": "Visibility", "response": "Ignore" }],
        "helpMessage": "WorldDynamic object that is invisible." },
      { "name": "Trigger", "collisionEnabled": "QueryOnly", "objectTypeName": "WorldDynamic", "canModify": false,
        "customResponses": [{ "channel": "WorldStatic", "response": "Overlap" }, { "channel": "Pawn", "response": "Overlap" }, { "channel": "Visibility", "response": "Ignore" }, { "channel": "WorldDynamic", "response": "Overlap" }, { "channel": "Camera", "response": "Overlap" }, { "channel": "PhysicsBody", "response": "Overlap" }, { "channel": "Vehicle", "response": "Overlap" }, { "channel": "Destructible", "response": "Overlap" }],
        "helpMessage": "WorldDynamic object that is used for trigger. All other channels will be set to default." },
      { "name": "Ragdoll", "collisionEnabled": "QueryAndPhysics", "objectTypeName": "PhysicsBody", "canModify": false,
        "customResponses": [{ "channel": "Pawn", "response": "Ignore" }, { "channel": "Visibility", "response": "Ignore" }],
        "helpMessage": "Simulating Skeletal Mesh Component. All other channels will be set to default." },
      { "name": "Vehicle", "collisionEnabled": "QueryAndPhysics", "objectTypeName": "Vehicle", "canModify": false,
        "customResponses": [],
        "helpMessage": "Vehicle object that blocks Vehicle, WorldStatic, and WorldDynamic. All other channels will be set to default." },
      { "name": "UI", "collisionEnabled": "QueryOnly", "objectTypeName": "WorldDynamic", "canModify": false,
        "customResponses": [{ "channel": "WorldStatic", "response": "Overlap" }, { "channel": "Pawn", "response": "Overlap" }, { "channel": "Visibility", "response": "Block" }, { "channel": "WorldDynamic", "response": "Overlap" }, { "channel": "Camera", "response": "Overlap" }, { "channel": "PhysicsBody", "response": "Overlap" }, { "channel": "Vehicle", "response": "Overlap" }, { "channel": "Destructible", "response": "Overlap" }],
        "helpMessage": "WorldStatic object that overlaps all actors by default. All new custom channels will use its own default response. " },
      { "name": "WaterBodyCollision", "collisionEnabled": "QueryOnly", "objectTypeName": "", "canModify": false,
        "customResponses": [{ "channel": "WorldDynamic", "response": "Overlap" }, { "channel": "Pawn", "response": "Overlap" }, { "channel": "Visibility", "response": "Ignore" }, { "channel": "Camera", "response": "Ignore" }, { "channel": "PhysicsBody", "response": "Overlap" }, { "channel": "Vehicle", "response": "Overlap" }, { "channel": "Destructible", "response": "Overlap" }],
        "helpMessage": "Default Water Collision Profile (Created by Water Plugin)" }
    ]
  }
}
