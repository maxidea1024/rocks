{
  "schema": 1,
  "id": "VULKAN_SM5",
  "status": "supported",
  "backend": "Vulkan",
  "processor": { "module": "ShaderFormatVulkan", "version": 2 },
  "bindingConvention": 1,
  "tools": ["DirectXShaderCompiler", "SpirvTools"],
  "language": { "hlsl2021": true },
  "compiler": {
    "path": "DxcSpirv",
    "shaderModel": "6_0",
    "imageFormat": "VkImageFormat",
    "spirvTargetEnv": "vulkan1.1",
    "dxPositionW": true
  },
  "stages": ["vertex", "pixel", "compute"],
  "limits": {
    "constantBuffers": 12,
    "sampledTextures": 128,
    "storageBuffers": 4,
    "storageImages": 4,
    "samplers": 16,
    "uavStages": ["compute"],
    "renderTargets": 8,
    "interStageVectors": 16,
    "rootConstantBytes": 128
  },
  "features": ["compute", "vertexViewportLayerOutput"],
  "deviceRequirements": ["VULKAN_1_1"],
  "producers": [{ "host": "windows-x64" }, { "host": "macos-arm64" }]
}
