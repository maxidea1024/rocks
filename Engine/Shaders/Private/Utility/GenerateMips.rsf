// 밉 생성이다(Docs/Design/EngineShaders 4.18절 A18·14.4절 5항, 결정 SLD23, UE ComputeGenerateMips.usf 역할).
// C++ 도우미는 RenderBase/GenerateMips.h다. 이전 mip(원본)에서 다음 mip(대상)을 만든다.
// - GenerateMipsCompute: 쓰기 view(대상 mip)에 쓴다. 퍼뮤테이션은 차원 MIPS_DIMENSION(0 2D·1 2D 배열·2 3D) ×
//   image 형식 MIPS_FORMAT(StorageImageFormat 번호 — float 계열만, GLES는 GLES 3.2 core 형식만)이다.
// - GenerateMipsPixel: 대상 mip·slice(3D는 깊이 면)를 렌더 타깃으로 그린다(FullscreenTriangleVertex와 짝).
//   퍼뮤테이션은 원본 차원 MIPS_SOURCE_DIMENSION(0 2D·1 2D 배열·2 cube·3 3D)이다. sRGB 형식은 이 경로다:
//   원본 view가 선형으로 풀고 렌더 타깃이 다시 부호화하므로 필터는 선형 공간이다.
//
// 필터는 축마다 정확한 면적 박스다: 원본 크기 s가 짝수면 (2x, 2x+1)을 ½씩, 홀수(s = 2d + 1)면 (2x, 2x+1, 2x+2)를
// ((d − x)/s, d/s, (x + 1)/s)로 — 대상 texel이 덮는 원본 구간과 겹친 길이의 비율이다. s = 1이면 그 texel이다.
// 알파도 같이 평균한다(premultiply 하지 않는다).
//
// 그리기별 상수 GenerateMips(32 byte)는 C++ RenderBase/UtilityShaderTypes.h GenerateMipsConstants의 생성
// 원문이다: source(원본 mip 폭·높이·깊이(3D 외 1), 원본 view 기준 mip — TextureViewBaseMip), destination(대상 mip
// 폭·높이·깊이, raster의 대상 slice·cube 면·3D 깊이 면).
#include "/Engine/Private/Common/ShaderPrelude.rsh"
#include "/Engine/Generated/RenderBase/GenerateMipsConstants.rsh"

// 축 하나에서 대상 texel이 읽는 원본 texel 셋(첫 번호부터, 원본 끝에서 clamp)과 가중이다(쓰지 않는 칸은 가중 0).
void MipAxisFootprint(uint destination, uint sourceSize, uint destinationSize, out uint3 taps, out float3 weights) {
    const uint first = sourceSize == 1u ? 0u : destination * 2u;
    const uint last = sourceSize - 1u;
    taps = min(uint3(first, first + 1u, first + 2u), uint3(last, last, last));
    const float s = (float)sourceSize;
    const float d = (float)destinationSize;
    const float x = (float)destination;
    const float3 odd = float3((d - x) / s, d / s, (x + 1.0) / s);
    const float3 even = float3(0.5, 0.5, 0.0);
    const float3 single = float3(1.0, 0.0, 0.0);
    weights = sourceSize == 1u ? single : ((sourceSize & 1u) != 0u ? odd : even);
}

#if defined(MIPS_DIMENSION) && defined(MIPS_FORMAT)

#if MIPS_FORMAT == 0
#define MIPS_IMAGE_FORMAT rgba8
#define MIPS_ELEMENT float4
#define MIPS_STORE(v) (v)
#elif MIPS_FORMAT == 1
#define MIPS_IMAGE_FORMAT rgba8snorm
#define MIPS_ELEMENT float4
#define MIPS_STORE(v) (v)
#elif MIPS_FORMAT == 2
#define MIPS_IMAGE_FORMAT rgba16f
#define MIPS_ELEMENT float4
#define MIPS_STORE(v) (v)
#elif MIPS_FORMAT == 3
#define MIPS_IMAGE_FORMAT rgba32f
#define MIPS_ELEMENT float4
#define MIPS_STORE(v) (v)
#elif MIPS_FORMAT == 4
#define MIPS_IMAGE_FORMAT r32f
#define MIPS_ELEMENT float
#define MIPS_STORE(v) (v).x
#elif MIPS_FORMAT == 8
#define MIPS_IMAGE_FORMAT rg16f
#define MIPS_ELEMENT float2
#define MIPS_STORE(v) (v).xy
#elif MIPS_FORMAT == 9
#define MIPS_IMAGE_FORMAT r16f
#define MIPS_ELEMENT float
#define MIPS_STORE(v) (v).x
#elif MIPS_FORMAT == 10
#define MIPS_IMAGE_FORMAT rg32f
#define MIPS_ELEMENT float2
#define MIPS_STORE(v) (v).xy
#elif MIPS_FORMAT == 11
#define MIPS_IMAGE_FORMAT r11g11b10f
#define MIPS_ELEMENT float3
#define MIPS_STORE(v) (v).xyz
#else
#error "GenerateMipsCompute takes float storage image formats only"
#endif

// ROCKS_IMAGE_FORMAT은 인자를 문자열로 만들므로 형식 매크로를 한 번 펼친 뒤 넘긴다.
#define MIPS_IMAGE_FORMAT_ATTRIBUTE(Format) ROCKS_IMAGE_FORMAT(Format)

#if MIPS_DIMENSION == 0
Texture2D<float4> MipSource;
MIPS_IMAGE_FORMAT_ATTRIBUTE(MIPS_IMAGE_FORMAT) RWTexture2D<MIPS_ELEMENT> MipTarget;
#define MIPS_GROUP_X 8
#define MIPS_GROUP_Y 8
#define MIPS_GROUP_Z 1
#elif MIPS_DIMENSION == 1
Texture2DArray<float4> MipSource;
MIPS_IMAGE_FORMAT_ATTRIBUTE(MIPS_IMAGE_FORMAT) RWTexture2DArray<MIPS_ELEMENT> MipTarget;
#define MIPS_GROUP_X 8
#define MIPS_GROUP_Y 8
#define MIPS_GROUP_Z 1
#else
Texture3D<float4> MipSource;
MIPS_IMAGE_FORMAT_ATTRIBUTE(MIPS_IMAGE_FORMAT) RWTexture3D<MIPS_ELEMENT> MipTarget;
#define MIPS_GROUP_X 4
#define MIPS_GROUP_Y 4
#define MIPS_GROUP_Z 4
#endif

// dispatch: 2D (⌈w/8⌉, ⌈h/8⌉, 1), 2D 배열 (⌈w/8⌉, ⌈h/8⌉, 층 수), 3D (⌈w/4⌉, ⌈h/4⌉, ⌈d/4⌉).
[numthreads(MIPS_GROUP_X, MIPS_GROUP_Y, MIPS_GROUP_Z)]
void GenerateMipsCompute(uint3 dispatchThreadId : SV_DispatchThreadID) {
    const uint3 destinationSize = GenerateMips.destination.xyz;
    const bool inside = dispatchThreadId.x < destinationSize.x && dispatchThreadId.y < destinationSize.y &&
                        (MIPS_DIMENSION != 2 || dispatchThreadId.z < destinationSize.z);
    if (inside) {
        uint3 tapsX = uint3(0u, 0u, 0u);
        uint3 tapsY = uint3(0u, 0u, 0u);
        float3 weightsX = float3(0.0, 0.0, 0.0);
        float3 weightsY = float3(0.0, 0.0, 0.0);
        MipAxisFootprint(dispatchThreadId.x, GenerateMips.source.x, destinationSize.x, tapsX, weightsX);
        MipAxisFootprint(dispatchThreadId.y, GenerateMips.source.y, destinationSize.y, tapsY, weightsY);
        const int mip = (int)GenerateMips.source.w;
        float4 sum = float4(0.0, 0.0, 0.0, 0.0);
#if MIPS_DIMENSION == 2
        uint3 tapsZ = uint3(0u, 0u, 0u);
        float3 weightsZ = float3(0.0, 0.0, 0.0);
        MipAxisFootprint(dispatchThreadId.z, GenerateMips.source.z, destinationSize.z, tapsZ, weightsZ);
        [unroll] for (uint z = 0u; z < 3u; ++z) {
            [unroll] for (uint y = 0u; y < 3u; ++y) {
                [unroll] for (uint x = 0u; x < 3u; ++x) {
                    const float weight = weightsX[x] * weightsY[y] * weightsZ[z];
                    sum += MipSource.Load(int4(int3(tapsX[x], tapsY[y], tapsZ[z]), mip)) * weight;
                }
            }
        }

        MipTarget[dispatchThreadId] = MIPS_STORE(sum);
#else
        [unroll] for (uint y = 0u; y < 3u; ++y) {
            [unroll] for (uint x = 0u; x < 3u; ++x) {
                const float weight = weightsX[x] * weightsY[y];
#if MIPS_DIMENSION == 1
                sum += MipSource.Load(int4(int2(tapsX[x], tapsY[y]), (int)dispatchThreadId.z, mip)) * weight;
#else
                sum += MipSource.Load(int3(int2(tapsX[x], tapsY[y]), mip)) * weight;
#endif
            }
        }

#if MIPS_DIMENSION == 1
        MipTarget[dispatchThreadId] = MIPS_STORE(sum);
#else
        MipTarget[dispatchThreadId.xy] = MIPS_STORE(sum);
#endif
#endif
    }
}

#endif

#if defined(MIPS_SOURCE_DIMENSION)

#if MIPS_SOURCE_DIMENSION == 0
Texture2D<float4> MipSource;
#elif MIPS_SOURCE_DIMENSION == 1
Texture2DArray<float4> MipSource;
#elif MIPS_SOURCE_DIMENSION == 2
TextureCube<float4> MipSource;
// cube는 Load가 없어 texel 중심 방향을 point 샘플러로 표본한다(C++가 point 샘플러를 준다).
SamplerState MipSourceSampler;
#else
Texture3D<float4> MipSource;
#endif

#if MIPS_SOURCE_DIMENSION == 2
// 면 face의 면 좌표 (s, t) ∈ [-1, 1](s 오른쪽·t 아래, D3D cube 면 규약)의 방향이다.
float3 CubeFaceDirection(uint face, float2 st) {
    const float3 positiveX = float3(1.0, -st.y, -st.x);
    const float3 negativeX = float3(-1.0, -st.y, st.x);
    const float3 positiveY = float3(st.x, 1.0, st.y);
    const float3 negativeY = float3(st.x, -1.0, -st.y);
    const float3 positiveZ = float3(st.x, -st.y, 1.0);
    const float3 negativeZ = float3(-st.x, -st.y, -1.0);
    const float3 x = face == 0u ? positiveX : negativeX;
    const float3 y = face == 2u ? positiveY : negativeY;
    const float3 z = face == 4u ? positiveZ : negativeZ;
    return face < 2u ? x : (face < 4u ? y : z);
}

// 면 face의 texel (x, y)(한 변 size) 값이다(texel 중심 방향 — point 표본이 그 texel 하나를 고른다).
float4 LoadCubeTexel(uint face, uint2 texel, uint size, float mip) {
    const float2 st = (float2(texel) + 0.5) / (float)size * 2.0 - 1.0;
    return MipSource.SampleLevel(MipSourceSampler, CubeFaceDirection(face, st), mip);
}
#endif

float4 GenerateMipsPixel(float4 position : SV_Position) : SV_Target0 {
    const uint2 destination = uint2(position.xy);
    uint3 tapsX = uint3(0u, 0u, 0u);
    uint3 tapsY = uint3(0u, 0u, 0u);
    float3 weightsX = float3(0.0, 0.0, 0.0);
    float3 weightsY = float3(0.0, 0.0, 0.0);
    MipAxisFootprint(destination.x, GenerateMips.source.x, GenerateMips.destination.x, tapsX, weightsX);
    MipAxisFootprint(destination.y, GenerateMips.source.y, GenerateMips.destination.y, tapsY, weightsY);
    const uint slice = GenerateMips.destination.w;
    const int mip = (int)GenerateMips.source.w;
    float4 sum = float4(0.0, 0.0, 0.0, 0.0);
#if MIPS_SOURCE_DIMENSION == 3
    uint3 tapsZ = uint3(0u, 0u, 0u);
    float3 weightsZ = float3(0.0, 0.0, 0.0);
    MipAxisFootprint(slice, GenerateMips.source.z, GenerateMips.destination.z, tapsZ, weightsZ);
    [unroll] for (uint z = 0u; z < 3u; ++z) {
        [unroll] for (uint y = 0u; y < 3u; ++y) {
            [unroll] for (uint x = 0u; x < 3u; ++x) {
                const float weight = weightsX[x] * weightsY[y] * weightsZ[z];
                sum += MipSource.Load(int4(int3(tapsX[x], tapsY[y], tapsZ[z]), mip)) * weight;
            }
        }
    }
#else
    [unroll] for (uint y = 0u; y < 3u; ++y) {
        [unroll] for (uint x = 0u; x < 3u; ++x) {
            const float weight = weightsX[x] * weightsY[y];
#if MIPS_SOURCE_DIMENSION == 0
            sum += MipSource.Load(int3(int2(tapsX[x], tapsY[y]), mip)) * weight;
#elif MIPS_SOURCE_DIMENSION == 1
            sum += MipSource.Load(int4(int2(tapsX[x], tapsY[y]), (int)slice, mip)) * weight;
#else
            sum += LoadCubeTexel(slice, uint2(tapsX[x], tapsY[y]), GenerateMips.source.x, (float)mip) * weight;
#endif
        }
    }
#endif

    return sum;
}

#endif
