// 정점 버퍼 없는 전체 화면 삼각형 VS다(Docs/Design/RenderBase 11.4절 2항, 엔진 셰이더 A18).
//
// 정점 번호 0·1·2를 clip (-1,-1)·(3,-1)·(-1,3)에 둔다. 대상 전체를 덮고 화면에서 반시계라 앞면이다.
// z = 0은 reversed-Z 원평면이다(UE 화면 VS와 같다). UV는 화면 UV 규약(왼쪽 위 (0,0), 아래로 +v,
// 엔진 셰이더 3.4절)이다.

struct FullscreenTriangleOutput {
    float4 position : SV_Position;
    float2 uv : TEXCOORD0;
};

FullscreenTriangleOutput FullscreenTriangleVertex(uint vertexId : SV_VertexID) {
    // 정점 번호 → 대상 UV (0,0)·(2,0)·(0,2).
    const float2 uv = float2((vertexId << 1) & 2, vertexId & 2);
    FullscreenTriangleOutput output;
    output.position = float4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.0, 1.0);
    output.uv = uv;
    return output;
}
