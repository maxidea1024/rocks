// 텍스처 복사 PS다(Docs/Design/RenderBase 11.4절 2항 — 엔진 셰이더 A18 CopyTexture의 2D 부분).
// FullscreenTriangleVertex와 짝을 이루어 2D 텍스처 Source를 화면 UV로 표본해 그대로 낸다. 샘플러는
// 텍스처 desc의 기본 샘플러다(RenderBase 결정 R12).

Texture2D Source;
SamplerState SourceSampler;

float4 CopyTexturePixel(float4 position : SV_Position, float2 uv : TEXCOORD0) : SV_Target0 {
    return Source.Sample(SourceSampler, uv);
}
