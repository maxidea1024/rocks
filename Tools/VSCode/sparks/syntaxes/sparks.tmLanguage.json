{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Sparks",
  "scopeName": "source.sparks",
  "fileTypes": [
    "spark"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#attribute"
    },
    {
      "include": "#declaration-names"
    },
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.sparks",
          "match": "///(?!/).*$"
        },
        {
          "name": "comment.line.double-slash.sparks",
          "match": "//.*$"
        },
        {
          "name": "comment.block.sparks",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.sparks"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.sparks"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.verbatim.sparks",
          "begin": "@\"",
          "end": "\"(?!\")",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sparks"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sparks"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.sparks",
              "match": "\"\""
            }
          ]
        },
        {
          "name": "string.quoted.double.sparks",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.sparks"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.sparks"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.sparks",
              "match": "\\\\(?:[\"\\\\nt$]|u\\{[0-9A-Fa-f]{1,6}\\})"
            },
            {
              "name": "invalid.illegal.escape.sparks",
              "match": "\\\\."
            },
            {
              "include": "#interpolation"
            }
          ]
        }
      ]
    },
    "interpolation": {
      "name": "meta.interpolation.sparks",
      "begin": "\\$\\{",
      "end": "\\}|(?=$)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.sparks"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.sparks"
        }
      },
      "patterns": [
        {
          "include": "#expression"
        }
      ]
    },
    "attribute": {
      "name": "storage.type.annotation.sparks",
      "match": "@(?!\")[A-Za-z][A-Za-z0-9]*"
    },
    "declaration-names": {
      "patterns": [
        {
          "match": "\\b(class|struct|enum|interface)\\s+([A-Za-z][A-Za-z0-9]*)",
          "captures": {
            "1": {
              "name": "storage.type.sparks"
            },
            "2": {
              "name": "entity.name.type.sparks"
            }
          }
        },
        {
          "match": "\\b(fn)\\s+([A-Za-z][A-Za-z0-9]*)",
          "captures": {
            "1": {
              "name": "storage.type.sparks"
            },
            "2": {
              "name": "entity.name.function.sparks"
            }
          }
        }
      ]
    },
    "expression": {
      "patterns": [
        {
          "include": "#keywords-control"
        },
        {
          "include": "#keywords-declaration"
        },
        {
          "include": "#keywords-modifier"
        },
        {
          "include": "#keywords-constant"
        },
        {
          "include": "#keywords-this"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#punctuation"
        }
      ]
    },
    "keywords-control": {
      "name": "keyword.control.sparks",
      "match": "\\b(if|else|for|in|while|switch|case|default|break|continue|return|await|try|emit)\\b"
    },
    "keywords-declaration": {
      "name": "storage.type.sparks",
      "match": "\\b(import|as|class|struct|enum|interface|event|fn|const|var|let|on)\\b"
    },
    "keywords-modifier": {
      "name": "storage.modifier.sparks",
      "match": "\\b(async|override|open)\\b"
    },
    "keywords-constant": {
      "name": "constant.language.sparks",
      "match": "\\b(true|false|null)\\b"
    },
    "keywords-this": {
      "name": "variable.language.this.sparks",
      "match": "\\b(this)\\b"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.sparks",
          "match": "\\b0[xX]_*[0-9A-Fa-f](?:_*[0-9A-Fa-f])*\\b"
        },
        {
          "name": "constant.numeric.binary.sparks",
          "match": "\\b0[bB]_*[01](?:_*[01])*\\b"
        },
        {
          "name": "constant.numeric.decimal.sparks",
          "match": "(?:\\b[0-9](?:_*[0-9])*(?:\\.[0-9](?:_*[0-9])*)?|\\.[0-9](?:_*[0-9])*)(?:[eE][+-]?[0-9](?:_*[0-9])*)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sparks",
          "match": "\\?\\?|\\?\\.|\\.\\.<|==|!=|<=|>=|&&|\\|\\||[-+*/]=?|%|=|!|<|>|\\?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.terminator.statement.sparks",
          "match": ";"
        },
        {
          "name": "punctuation.separator.sparks",
          "match": "[,:]"
        },
        {
          "name": "punctuation.accessor.sparks",
          "match": "\\."
        }
      ]
    }
  }
}
